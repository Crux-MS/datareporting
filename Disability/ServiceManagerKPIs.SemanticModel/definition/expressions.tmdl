expression fnCleanColumnNames =
		let
		    fnCleanColumnNames = (tbl as table) as table =>
		        let
		            OldNames = Table.ColumnNames(tbl),
		            NewNames = List.Transform(OldNames, each Text.Proper(Text.Replace(_, "_", " "))),
		            Result   = Table.RenameColumns(tbl, List.Zip({OldNames, NewNames}))
		        in
		            Result
		in
		      fnCleanColumnNames
	lineageTag: 4073fc95-6d78-4bb6-b6ab-8dd8e981b341
	queryGroup: Utilities

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

