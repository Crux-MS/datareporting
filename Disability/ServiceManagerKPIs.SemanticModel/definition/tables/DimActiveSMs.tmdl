	partition DimActiveSMs = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"ServerName", #"DatabaseName", [Query="WITH Employees AS (#(lf)    SELECT [Id_Employee]#(lf)      ,[Id_Employee_Payroll]#(lf)      ,[Id_Organisation]#(lf)      ,[Id_Manager]#(lf)      ,[Company_Email]#(lf)      ,[Employee_Name]#(lf)      ,[Location]#(lf)      ,[Employing_Entity]#(lf)      ,[Job_Title]#(lf)      ,[Employee_Status]#(lf)      ,[Role_Category]#(lf)      ,[Start_Date]#(lf)      ,[Termination_Date]#(lf)    FROM [Dim].[employee]#(lf)),#(lf)ServiceManagers AS (#(lf)    SELECT *#(lf)    FROM Employees#(lf)    WHERE Role_Category = 'Service Manager' and [Employee_Status] = 'active'#(lf))#(lf)SELECT sm.[Id_Employee]  AS [Id_Service_Manager]#(lf)      ,sm.[Id_Employee_Payroll] AS [Id_Service_Manager_Payroll]#(lf)      ,sm.[Id_Organisation]#(lf)      ,sm.[Company_Email]#(lf)      ,e.[Employee_Name] AS [Regional_Manager_Name]#(lf)      ,sm.[Employee_Name] AS [Service_Manager_Name]#(lf)      ,sm.[Location]#(lf)      ,sm.[Employing_Entity]#(lf)      ,sm.[Job_Title]#(lf)      ,sm.[Role_Category]#(lf)      ,sm.[Start_Date]#(lf)      ,sm.[Termination_Date]#(lf)FROM ServiceManagers sm#(lf)LEFT JOIN Employees e ON sm.[Id_Manager] = e.[Id_Employee]"]),
				    RenameColumns = fnCleanColumnNames(Source)
				in
				    RenameColumns

	annotation PBI_NavigationStepName = Navigation

