table ParameterMeasures
	lineageTag: 6a5e55d0-543b-466c-a321-70bb7efbb9c1

	measure ClientsCasCount = ```
			IF(
			    SELECTEDVALUE(WeeklyMonthlyParam[WeeklyMonthlySelector Fields]) = "'DimDate'[Start of Month]", 
			    SUM(FactSMMonthlySnapshot[Client Active Cas Count]), 
			    SUM(FactSMWeeklySnapshot[Client Active Cas Count])
			)
			```
		formatString: 0
		displayFolder: Clients
