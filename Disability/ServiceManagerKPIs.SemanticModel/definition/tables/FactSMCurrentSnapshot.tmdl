	measure CountAllSACSAgreementEmployees = ```
			SUM(FactSMCurrentSnapshot[Employee_SACS_Level_1_Count]) + 
			SUM(FactSMCurrentSnapshot[Employee_SACS_Level_2_Count]) + 
			SUM(FactSMCurrentSnapshot[Employee_SACS_Level_3_Count]) + 
			SUM(FactSMCurrentSnapshot[Employee_SACS_Level_4_Count]) + 
			SUM(FactSMCurrentSnapshot[Employee_SACS_Level_5_Count]) + 
