table FactSMMonthlySnapshot
	lineageTag: dc64fd2c-b0c4-4a3f-a4e6-64d2c29bdab6

	measure OvertimeRate = DIVIDE(SUM(FactSMMonthlySnapshot[Payroll Overtime Hours]), [TotalMonthlyHoursPaid])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Employees
		lineageTag: 00b5fdfd-a5bb-425e-ae67-b790a0c31f6a

	measure LeavePaidMonthlyRate = DIVIDE(SUM(FactSMMonthlySnapshot[Payroll Leave Hours]), [TotalMonthlyHoursPaid])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Payroll
		lineageTag: 1c4066f0-8cfe-474e-a3a2-43ac1843a244

	measure TotalMonthlyScheduledHours = SUM(FactSMMonthlySnapshot[Worker Scheduled Sil Hours]) + SUM(FactSMMonthlySnapshot[Worker Scheduled Nonsil Hours])
		formatString: #,0.00
		displayFolder: Clients
		lineageTag: bfbd4776-d60c-48fe-a628-82ee094e93da

	measure TotalMonthlyUndeliveredHours = SUM(FactSMMonthlySnapshot[Worker Undelivered Nonsil Hours]) + SUM(FactSMMonthlySnapshot[Worker Undelivered Sil Hours])
		formatString: #,0.00
		displayFolder: Clients
		lineageTag: 453c0264-8966-492a-a7a2-83b69d7b4827

	measure TotalMonthlyHoursPaid = SUM(FactSMMonthlySnapshot[Payroll Standard Hours]) + SUM(FactSMMonthlySnapshot[Payroll Leave Hours]) + SUM(FactSMMonthlySnapshot[Payroll Overtime Hours]) + SUM(FactSMMonthlySnapshot[Payroll Other Hours])
		displayFolder: Payroll
		lineageTag: da249ad9-ccf9-4eff-8777-bab86a529248

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CountMonthlyActiveClients = SUM(FactSMMonthlySnapshot[Client Active Cas Count]) + SUM(FactSMMonthlySnapshot[Client Active Sil Count]) + SUM(FactSMMonthlySnapshot[Client Active Unknown Count])
		formatString: 0
		displayFolder: Clients
		lineageTag: 81e1ba28-0921-48ea-be79-78adbbcd2a35

	measure OvertimePaidMonthlyRate = DIVIDE(SUM(FactSMMonthlySnapshot[Payroll Overtime Hours]), [TotalMonthlyHoursPaid])
		displayFolder: Payroll
		lineageTag: 910bdbda-87ab-4779-b50c-d79715dacacc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalMonthlyHoursDelivered = SUM(FactSMMonthlySnapshot[Worker Delivered Cas Hours]) + SUM(FactSMMonthlySnapshot[Worker Delivered Other Hours]) + SUM(FactSMMonthlySnapshot[Worker Delivered Sil Hours])
		lineageTag: 2f6c329c-b3d8-40c4-b628-c7282f21cea0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure SILMonthlyHoursDeliveredRate = DIVIDE(SUM(FactSMMonthlySnapshot[Worker Delivered Sil Hours]), [TotalMonthlyHoursDelivered])
		lineageTag: add6fadb-4bd8-4ec6-82c7-f9af4a437401

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CASMonthlyHoursDeliveredRate = DIVIDE(SUM(FactSMMonthlySnapshot[Worker Delivered Cas Hours]), [TotalMonthlyHoursDelivered])
		lineageTag: 0e456cae-d7c8-43ff-aa9a-1e8c2770e0e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OtherMonthlyHoursDeliveredRate = DIVIDE(SUM(FactSMMonthlySnapshot[Worker Delivered Other Hours]), [TotalMonthlyHoursDelivered])
		lineageTag: d0e53f80-9072-4ffd-9a39-78084e60c3a7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

