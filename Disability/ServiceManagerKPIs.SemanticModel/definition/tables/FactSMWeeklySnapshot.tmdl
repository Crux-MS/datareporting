table FactSMWeeklySnapshot
	lineageTag: b6b10dd1-61a7-42c6-950c-bec57e3124bd

	measure TotalWeeklyHoursPaid = SUM(FactSMWeeklySnapshot[Payroll Standard Hours]) + SUM(FactSMWeeklySnapshot[Payroll Leave Hours]) + SUM(FactSMWeeklySnapshot[Payroll Overtime Hours]) + SUM(FactSMWeeklySnapshot[Payroll Other Hours])
		formatString: #,0.0
		displayFolder: Payroll
		lineageTag: a41641d3-9c30-44e8-bc9a-1852f1572563

	measure LeavePaidWeeklyRate = DIVIDE(SUM(FactSMWeeklySnapshot[Payroll Leave Hours]), [TotalWeeklyHoursPaid])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Payroll
		lineageTag: 1500ab33-199a-48e4-973f-d961fec31d08

	measure OvertimePaidWeeklyRate = DIVIDE(SUM(FactSMWeeklySnapshot[Payroll Overtime Hours]), [TotalWeeklyHoursPaid])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Payroll
		lineageTag: 366a25f4-037f-40f5-924b-5aa7f529f018

	measure CountWeeklyActiveClients = SUM(FactSMWeeklySnapshot[Client Active Cas Count]) + SUM(FactSMWeeklySnapshot[Client Active Sil Count]) + SUM(FactSMWeeklySnapshot[Client Active Unknown Count])
		formatString: 0
		displayFolder: Clients
		lineageTag: 93c8d27c-f82d-403f-a28e-ee173549a9a7

	measure TotalWeeklyScheduledHours = SUM(FactSMWeeklySnapshot[Worker Scheduled Nonsil Hours]) + SUM(FactSMWeeklySnapshot[Worker Scheduled Sil Hours])
		displayFolder: Clients
		lineageTag: fe1eee3e-5a48-482b-ba3a-d1e1d1c3d132

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalWeeklyImpactedHours = SUM(FactSMWeeklySnapshot[Worker Undelivered Nonsil Hours]) + SUM(FactSMWeeklySnapshot[Worker Undelivered Sil Hours])
		displayFolder: Clients
		lineageTag: cc28779a-402e-4596-98d6-ef3e8a442dc5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalWeeklyHoursDelivered = SUM(FactSMWeeklySnapshot[Worker Delivered Cas Hours]) + SUM(FactSMWeeklySnapshot[Worker Delivered Other Hours]) + SUM(FactSMWeeklySnapshot[Worker Delivered Sil Hours])
		formatString: #,0.0
		displayFolder: Workers
		lineageTag: 44d626b5-19d9-4885-923e-037492f030af

	measure SILWeeklyHoursDeliveredRate = DIVIDE(SUM(FactSMWeeklySnapshot[Worker Delivered Sil Hours]), [TotalWeeklyHoursDelivered])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Workers
		lineageTag: 6dee5c3b-09de-46cc-a656-59329011e3e9

	measure CASWeeklyHoursDeliveredRate = DIVIDE(SUM(FactSMWeeklySnapshot[Worker Delivered Cas Hours]), [TotalWeeklyHoursDelivered])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Workers
		lineageTag: a814869e-c615-49be-865d-bc8decfce536

	measure OtherWeeklyHoursDeliveredRate = DIVIDE(SUM(FactSMWeeklySnapshot[Payroll Other Hours]), [TotalWeeklyHoursDelivered])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Workers
		lineageTag: bb9802f2-3769-4060-be04-cc4b75f3fd16

	measure WeeklyHoursCancelledRate = DIVIDE(SUM(FactSMWeeklySnapshot[Worker Cancellation Hours]), [TotalWeeklyHoursDelivered])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Workers
		lineageTag: 221d0c07-55d0-4927-9e09-8272f4da2815

