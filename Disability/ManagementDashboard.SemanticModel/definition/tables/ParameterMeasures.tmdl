	measure MaxUnbillableUtilisationRate =
			VAR _paramFieldValue = SELECTEDVALUE(WorkerTypeParam[Parameter Fields])
			VAR _peakServiceManagerRate = CEILING(
			    SWITCH(
			        TRUE(),
			        SELECTEDVALUE(WeekMonthParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", MAXX(VALUES(DimDate[Start of Month]), [WorkerUnbillableHoursRate]),
			        SELECTEDVALUE(WeekMonthParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", MAXX(VALUES(DimDate[Start of Week (Monday)]), [WorkerUnbillableHoursRate])
			    ),
			    0.05
			)
			RETURN
			SWITCH(TRUE(),
			    SELECTEDVALUE(WorkerTypeParam[Parameter Fields]) = "'Worker Type'[Total]", 1,
			    SELECTEDVALUE(WorkerTypeParam[Parameter Fields]) = "'Worker Type'[Workers]", 1,
			    SELECTEDVALUE(WorkerTypeParam[Parameter Fields]) = "'Worker Type'[Service Managers]", _peakServiceManagerRate
			    )
		lineageTag: 425ba410-18f3-4c24-8c0f-6b11eb1471a8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ParameterMeasures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measures = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Measures", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Measures"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

