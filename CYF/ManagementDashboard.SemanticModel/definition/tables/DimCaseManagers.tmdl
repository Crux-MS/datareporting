	/// Definition: Work location recorded for the case manager.
	column 'Case Manager Location'
		dataType: string
		lineageTag: af850cd2-1d51-4d73-b1bd-089fb2b88b8c
		summarizeBy: none
		sourceColumn: Case Manager Location

		annotation SummarizationSetBy = Automatic

	/// Definition: Employment status of the case manager.
	/// For analysis: Includes inactive case managers; filter here for current staff only.
	column 'Case Manager Status'
		dataType: string
		lineageTag: 30ea4a0f-a7ee-4320-8a79-e36c922679d6
		summarizeBy: none
		sourceColumn: Case Manager Status

