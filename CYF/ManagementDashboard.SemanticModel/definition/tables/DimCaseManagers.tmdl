	column 'Case Manager Division'
		dataType: string
		lineageTag: e2e3a124-c337-4055-bb50-eae8af3c8816
		summarizeBy: none
		sourceColumn: Case Manager Division

		annotation SummarizationSetBy = Automatic

	partition DimCaseManagers = m
		mode: import
		source =
				let
				    Source = Sql.Database(ServerName, DatabaseName, [Query="WITH Employees AS (#(lf)    SELECT [Id_Employee]#(lf)      ,[Id_Employee_Payroll]#(lf)      ,[Id_Organisation]#(lf)      ,[Id_Manager]#(lf)      ,[Company_Email]#(lf)      ,[Employee_Name]#(lf)      ,[Division]#(lf)      ,[Location]#(lf)      ,[Employing_Entity]#(lf)      ,[Job_Title]#(lf)      ,[Employee_Status]#(lf)      ,[Role_Category]#(lf)      ,[Start_Date]#(lf)      ,[Termination_Date]#(lf)    FROM [Dim].[employee]#(lf)),#(lf)ServiceManagers AS (#(lf)    SELECT *#(lf)    FROM Employees#(lf)    WHERE Role_Category = 'Case Manager' OR [Job_Title] = 'Family Support Coordinator' OR [Job_Title] = 'Regional Manager - Children, Youth and Family Services (Acting)'#(lf))#(lf)SELECT sm.[Id_Employee]             AS [Id_Case_Manager]#(lf)      ,sm.[Id_Employee_Payroll]     AS [Id_Case_Manager_Payroll]#(lf)      ,sm.[Id_Organisation]#(lf)      ,sm.[Company_Email]#(lf)      ,sm.[Employee_Name]           AS [Case_Manager_Name]#(lf)      ,sm.[Division]                AS [Case_Manager_Division]#(lf)      ,sm.[Location]                AS [Case_Manager_Location]#(lf)      ,e.[Employee_Name]            AS [Regional_Manager_Name]#(lf)      ,e.[Location]                 AS [Regional_Manager_Location]#(lf)      ,e.[Employee_Status]          AS [Regional_Manager_Status]#(lf)      ,sm.[Employing_Entity]#(lf)      ,sm.[Job_Title]#(lf)      ,sm.[Role_Category]#(lf)      ,sm.[Employee_Status]         AS [Case_Manager_Status]#(lf)      ,sm.[Start_Date]#(lf)      ,sm.[Termination_Date]#(lf)FROM ServiceManagers sm#(lf)LEFT JOIN Employees e ON sm.[Id_Manager] = e.[Id_Employee]"]),
				    RenameColumns = #"fnCleanColumnNames"(Source)
				in
				    RenameColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

