/// Definition: Case manager KPIs per week for CYF case managers: clients, employees, payroll, shifts and schedules, from the weekly case manager KPI table in L4_Analytical (selected columns). One row per case manager, area and week (Monday start).
/// For analysis: Pre-aggregated in the warehouse. Group by DimCaseManagers, DimArea and DimDate through Week Start Date.
table FactCMWeeklySnapshot
	lineageTag: 00d788db-f953-40cd-8f94-b045cf918ba4

	/// Definition: Date the week (Monday start) starts.
	/// For analysis: Key: joins DimDate Date; group by DimDate period columns.
	column 'Week Start Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: 409c49d6-62d1-4598-b6a1-504daaa6b059
		summarizeBy: none
		sourceColumn: Week Start Date

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

