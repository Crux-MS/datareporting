	measure WorkerLeaveHours =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Payroll Leave Hours]),
