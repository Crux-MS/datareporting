/// Definition: Report measures that switch between weekly, fortnightly and monthly case manager snapshot figures based on the period slicer, and between funding streams or worker types.
/// For analysis: Report display measures. Not for analysis; use the snapshot table columns.
table ParameterMeasures
	lineageTag: 0e431f16-9c3d-470b-8352-0bed5a162842

	/// Definition: The number of clients who started receiving services from the selected case managers in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot Client Enter columns instead.
	measure ClientEntries =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Client Enter Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Client Enter Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Client Enter Count]))
		formatString: 0
		displayFolder: WeeklyMonthly
		lineageTag: fa509024-1eb2-4527-b73f-94c4cb28bb4b

	/// Definition: The number of clients who stopped receiving services from the selected case managers in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot Client Exit columns instead.
	measure ClientExits =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Client Exit Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Client Exit Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Client Exit Count]))
		displayFolder: WeeklyMonthly
		lineageTag: fa8185c8-f27a-44f3-b1fb-f7b057562367

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: The number of active clients for the selected case managers in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot Client Active columns instead.
	measure ActiveClients =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Client Active Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Client Active Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Client Active Count]))
		formatString: 0
		displayFolder: WeeklyMonthly
		lineageTag: 49b8ec62-62a6-49a3-b104-bed82b7cbe64

	/// Definition: The number of client service hours scheduled for the selected case managers in each week, fortnight or month, for the funding stream chosen on the page (all, IPS, OSD or other).
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot Client Schedule Hours columns instead.
	measure ClientScheduledHours =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", [ClientScheduledHoursMonthly],
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", [ClientScheduledHoursFortnightly],
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", [ClientScheduledHoursWeekly])
		formatString: #,0.0
		displayFolder: WeeklyMonthly
		lineageTag: d14cf02a-ae6c-4300-ba81-d5a3eb5d567b

	/// Definition: The number of scheduled client service hours that were completed in each week, fortnight or month, for the funding stream chosen on the page (all, IPS, OSD or other).
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot Client Schedule Hours Completed columns instead.
	measure ClientCompleteHours =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", [ClientCompletedHoursMonthly],
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", [ClientCompletedHoursFortnightly],
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", [ClientCompletedHoursWeekly])
		formatString: #,0.0
		displayFolder: WeeklyMonthly
		lineageTag: 9aea7a83-1292-4f7b-887c-4ed5dff33afa

	/// Definition: The number of billable CYF hours delivered in each week, fortnight or month, by workers, case managers or both depending on the worker type chosen.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Add snapshot Worker Billable Cyf Hours and Worker Sm Billable Cyf Hours instead.
	measure WorkerBillableHours =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", [WorkerBillableHoursMonthly],
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", [WorkerBillableHoursFortnightly],
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", [WorkerBillableHoursWeekly]
			    )
		formatString: #,0.0
		displayFolder: WeeklyMonthly
		lineageTag: 7a9086b6-3540-4464-8bfe-33bb72d3cb44

	/// Definition: The total unbillable hours across admin, awake, meetings, other, Public Holiday Not Worked, shadow shifts, training and travel, in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Add the snapshot Worker Unbillable and Worker Sm Unbillable columns instead.
	measure WorkerUnbillableHours = [WorkerUnbillableAdminHours] + [WorkerUnbillableAwakeHours] + [WorkerUnbillableMeetingHours] + [WorkerUnbillableOtherHours] + [WorkerUnbillablePHNWHours] + [WorkerUnbillableShadowShiftHours] + [WorkerUnbillableTrainingHours] + [WorkerUnbillableTravelHours]
		displayFolder: WeeklyMonthly
		lineageTag: 93ff3a88-83c9-4220-bfc6-afc83ecdf46e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: Unbillable hours as a percentage of billable CYF hours.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Divide total unbillable hours by billable CYF hours from the snapshot instead.
	measure WorkerUnbillableHoursRate = DIVIDE([WorkerUnbillableHours], [WorkerBillableHours])
		formatString: #,0.00%;-#,0.00%;#,0.00%
		displayFolder: WeeklyMonthly
		lineageTag: 82fdf4f6-de74-4bd5-a2db-bbee3ad191ea

	/// Definition: The total overtime hours paid to employees in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot column Payroll Overtime Hours instead.
	measure WorkerOvertimeHours =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Payroll Overtime Hours]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Payroll Overtime Hours]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Payroll Overtime Hours]))
		displayFolder: WeeklyMonthly
		lineageTag: d1decc2b-2918-4f0f-a6a5-8c7ae4eed143

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: The total leave hours paid to employees in each week, fortnight or month.
