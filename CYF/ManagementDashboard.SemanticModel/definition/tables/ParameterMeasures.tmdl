			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Payroll Leave Hours]))
		displayFolder: WeeklyMonthly
		lineageTag: bedd4519-69cb-4e6b-83aa-c5c3a1b91db2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: The total standard hours paid to employees in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot column Payroll Standard Hours instead.
	measure WorkerStandardHours =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Payroll Standard Hours]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Payroll Standard Hours]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Payroll Standard Hours]))
		displayFolder: WeeklyMonthly
		lineageTag: 154bcbe9-4ad7-4f4b-ab43-040d4b5d7814

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: The total other hours paid to employees in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot column Payroll Other Hours instead.
	measure WorkerOtherHours =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Payroll Other Hours]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Payroll Other Hours]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Payroll Other Hours]))
		displayFolder: WeeklyMonthly
		lineageTag: a9d562c1-21ca-4ce9-95f8-d7736b8b779c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: The share of total hours paid that was overtime.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Divide snapshot Payroll Overtime Hours by total payroll hours instead.
	measure WorkerOvertimeRate = DIVIDE([WorkerOvertimeHours], [WorkerHoursPaid])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: WeeklyMonthly
		lineageTag: 5a960b89-7e68-4a1a-bc29-01d08bebbb14

	/// Definition: The total hours paid to employees, adding standard, leave, overtime and other hours, in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Add the snapshot Payroll Standard, Leave, Overtime and Other Hours instead.
	measure WorkerHoursPaid = [WorkerStandardHours] + [WorkerLeaveHours] + [WorkerOvertimeHours] + [WorkerOtherHours]
		displayFolder: WeeklyMonthly
		lineageTag: 6d616b59-aa75-4243-8481-02bbcb1317cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: Client entries minus client exits in each week, fortnight or month; a positive number means the client base grew.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Subtract snapshot Client Exit Count from Client Enter Count instead.
	measure ClientsNetChange = [ClientEntries] - [ClientExits]
		formatString: 0
		displayFolder: WeeklyMonthly
		lineageTag: 15680053-c3f4-4ccd-bdf0-b0894ced1314

