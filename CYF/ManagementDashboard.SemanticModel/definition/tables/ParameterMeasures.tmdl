	/// Definition: The number of active employees who report to the selected case managers in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot column Employee Active Count instead.
	measure ActiveEmployees =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Employee Active Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Employee Active Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Employee Active Count]))
		formatString: #,0
		displayFolder: WeeklyMonthly
		lineageTag: 333064c1-5bb7-4101-a5da-2c35c2023fe4

	/// Definition: The number of workers who worked at least one shift in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Use the snapshot column Worker With Shift Count instead.
	measure WorkerWithShiftCount =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Worker With Shift Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Worker With Shift Count]),
			    SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Worker With Shift Count]))
		formatString: #,0
		displayFolder: WeeklyMonthly
		lineageTag: 649dab28-264c-4b4a-af64-220c8d0647a6

	/// Definition: The share of active employees who worked at least one shift in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Divide snapshot Worker With Shift Count by Employee Active Count instead.
	measure WorkerWithShiftRate = DIVIDE([WorkerWithShiftCount], [ActiveEmployees])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: WeeklyMonthly
		lineageTag: 2975d5dd-933d-48e5-a242-2fe424e3fa3a

	/// Definition: The total hours of completed shifts worked by employees who report to the selected case managers, counting back from today:
	/// - Months: last 12 months
	/// - Fortnights: last 6 months
	/// - Weeks: last 12 weeks
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Sum FactCMWorkerRoster Duration Hours for completed shifts instead.
	measure EmployeeCompletedShifts =
			VAR _today = TODAY ()
			VAR _windowStart =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( PeriodParam[MonthWeekParam Fields] ) = "'DimDate'[Start of Month]", EDATE ( DATE ( YEAR ( _today ), MONTH ( _today ), 1 ), -12 ),
			        SELECTEDVALUE(PeriodParam[MonthWeekParam Fields]) = "'DimDate'[Fortnight Start Date]", EDATE ( DATE ( YEAR ( _today ), MONTH ( _today ), 1 ), -6 ),
			        SELECTEDVALUE ( PeriodParam[MonthWeekParam Fields] ) = "'DimDate'[Start of Week (Monday)]", _today - (12 * 7)
			    )
			RETURN
			    CALCULATE (
			        [TotalCompletedShifts],          // <-- your daily metric
			        KEEPFILTERS (
			            'DimDate'[Date] >= _windowStart && 'DimDate'[Date] <= _today
			        )
			    )
		displayFolder: WeeklyMonthly
		lineageTag: 598941a0-aa4a-46a9-bb90-1eb33694a90e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

