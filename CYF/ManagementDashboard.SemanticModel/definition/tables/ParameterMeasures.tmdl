	/// Definition: The target for unbillable hours as a share of billable CYF hours, set at 9.5%.
	/// For analysis: Fixed target value for charts and conditional formatting.
	measure WorkerUnbillableHoursTargetRate = 0.095
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Targets
		lineageTag: 1105ee89-a96c-40f3-82ee-d9feaf35f358

	/// Definition: The target for overtime as a share of total hours paid, set at 5.5%.
	/// For analysis: Fixed target value for charts and conditional formatting.
	measure WorkerOvertimeTargetRate = 0.055
		displayFolder: Targets
		lineageTag: d18034e6-e023-4245-b4a9-ef4d3c581a0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: Status of unbillable hours against target: 0 below the 9.5% target, 1 from 9.5% to under 11%, 2 at 11% or more.
	/// For analysis: Drives conditional formatting icons. Not for analysis.
	measure WorkerUnbillableExceedsTarget =
			SWITCH(
			    TRUE(),
			    [WorkerUnbillableHoursRate] < [WorkerUnbillableHoursTargetRate], 0,
			    [WorkerUnbillableHoursRate] >= [WorkerUnbillableHoursTargetRate] && [WorkerUnbillableHoursRate] < 0.11, 1,
			    [WorkerUnbillableHoursRate] >= 0.11, 2
			)
		formatString: 0
		lineageTag: 57c641c0-6f8f-44ac-996f-02cfde8b4174

	/// Definition: Status of overtime against target: 0 below the 5.5% target, 1 from 5.5% to under 7%, 2 at 7% or more.
	/// For analysis: Drives conditional formatting icons. Not for analysis.
	measure WorkerOvertimeExceedsTarget =
			SWITCH(
			    TRUE(),
			    [WorkerOvertimeRate] < [WorkerOvertimeTargetRate], 0,
			    [WorkerOvertimeRate] >= [WorkerOvertimeTargetRate] && [WorkerOvertimeRate] < 0.07, 1,
			    [WorkerOvertimeRate] >= 0.07, 2
			)
		formatString: 0
		lineageTag: a581ea11-cb4e-4b5c-8b6b-659bce3a66fb

	/// Definition: The average cost per hour paid, worked out as total pay divided by total hours paid, in each week, fortnight or month.
	/// For analysis: Report display measure that changes with the period slicer. Not for analysis. Divide total payroll amounts by total payroll hours from the snapshot instead.
	measure WorkerWeightedCost = DIVIDE([WorkerAmountPaid], [WorkerHoursPaid])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f844f347-a62f-444e-8907-651e6c2e2f1d

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	partition ParameterMeasures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Measures = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Measures", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Measures"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

