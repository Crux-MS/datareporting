	partition DimDate = m
		mode: import
		source =
				let
				    Source = Sql.Database(#"ServerName", #"DatabaseName"),
				    Dim_date = Source{[Schema="Dim",Item="date"]}[Data],
				    #"Clean Column Names" = #"fnCleanColumnNames"(Dim_date),
				    #"Inserted Start of Week" = Table.AddColumn(#"Clean Column Names", "Start of Week (Monday)", each Date.StartOfWeek([Date], Day.Monday), type date),
				    #"Inserted Start of Month" = Table.AddColumn(#"Inserted Start of Week", "Start of Month", each Date.StartOfMonth([Date]), type date)
				in
				    #"Inserted Start of Month"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

