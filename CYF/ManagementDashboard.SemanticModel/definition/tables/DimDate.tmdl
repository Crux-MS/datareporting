	/// Definition: Name of the weekday.
	column 'Day Name'
		dataType: string
		lineageTag: ad7956df-1c9c-448e-83b1-73d53db2831c
		summarizeBy: none
		sourceColumn: Day Name

		annotation SummarizationSetBy = Automatic

	/// Definition: Weekday number, 1 (Sunday) to 7 (Saturday).
	/// For analysis: Do not sum.
	column 'Day Of Week'
		dataType: int64
		formatString: 0
		lineageTag: 01804d0b-cc4c-4fed-8a22-808b1bbab9ce
		summarizeBy: sum
		sourceColumn: Day Of Week

		annotation SummarizationSetBy = Automatic

	/// Definition: Week number within the calendar year.
