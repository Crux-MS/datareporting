/// Definition: Calendar of dates with week, fortnight, month and financial year attributes, from the date table in L4_Analytical. One row per date.
/// For analysis: Main date table for the snapshot tables, the roster, critical incidents and Standard of Care Reviews.
table DimDate
	lineageTag: 325114c7-d0d3-4c7e-a5ac-985bb5401676

	/// Definition: Date key in YYYYMMDD form.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Date'
		dataType: int64
		formatString: 0
		lineageTag: ae3089c0-9bf4-4e26-a340-2b47972c4d97
		summarizeBy: sum
		sourceColumn: Id Date

		annotation SummarizationSetBy = Automatic

	/// Definition: Calendar date.
	/// For analysis: Key: one row per date.
	column Date
		dataType: dateTime
		formatString: Long Date
		lineageTag: cc252228-55e9-4163-b360-6c5c620b66ba
		summarizeBy: none
		sourceColumn: Date

		variation Variation
			isDefault
			relationship: 165ee5de-b40f-4278-8491-3fd0bec59d45
			defaultHierarchy: LocalDateTable_108e9768-b538-4f7f-a2a8-70c61fb49db3.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Definition: Calendar year.
	/// For analysis: Do not sum.
	column Year
