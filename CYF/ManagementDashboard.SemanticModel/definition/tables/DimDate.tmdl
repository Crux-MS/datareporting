	column 'Week Of Year'
		dataType: int64
		formatString: 0
		lineageTag: 9c294313-c49b-43b3-92bc-cb683b31be5e
		summarizeBy: sum
		sourceColumn: Week Of Year

		annotation SummarizationSetBy = Automatic

	/// Definition: True for Saturdays and Sundays.
	column 'Is Weekend'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: e04d40bc-7da5-4d7e-942e-e65cd4c7d04a
		summarizeBy: none
		sourceColumn: Is Weekend

		annotation SummarizationSetBy = Automatic

	/// Definition: Australian financial year (1 July to 30 June), for example FY2026-27.
	column 'Financial Year'
		dataType: string
		lineageTag: 20beca53-b334-4dc3-b8b2-8d1e2fa1a5ba
		summarizeBy: none
		sourceColumn: Financial Year

