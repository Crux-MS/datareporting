		formatString: 0
		lineageTag: f43464cb-625f-49a8-a4fa-6cb8ad338daf
		summarizeBy: sum
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	/// Definition: Month number, 1 to 12.
	/// For analysis: Do not sum.
	column Month
		dataType: int64
		formatString: 0
		lineageTag: dae5ad31-072f-4950-99a8-d82068cd79bc
		summarizeBy: sum
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	/// Definition: Month name.
	column 'Month Name'
		dataType: string
		lineageTag: d4a54597-a7cc-4ca9-8b9b-4cde4806b6ac
		summarizeBy: none
		sourceColumn: Month Name

		annotation SummarizationSetBy = Automatic

	/// Definition: Day of the month.
	/// For analysis: Do not sum.
	column Day
		dataType: int64
		formatString: 0
		lineageTag: e64dbb34-3abd-41df-b26c-28d060806d88
		summarizeBy: sum
		sourceColumn: Day

