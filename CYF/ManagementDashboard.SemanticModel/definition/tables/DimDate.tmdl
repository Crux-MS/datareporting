		formatString: 0
		lineageTag: 3c2cae9c-f8d6-4b02-be3f-c6fdf416f05d
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	/// Definition: Calendar quarter, 1 to 4.
	/// For analysis: Do not sum.
	column Quarter
