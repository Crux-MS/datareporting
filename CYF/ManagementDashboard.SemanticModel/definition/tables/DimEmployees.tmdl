/// Definition: Employees, their manager, role and employment details, from the HR employee table in L4_Analytical (all columns). One row per employee.
/// For analysis: Linked to DimCaseManagers through Id Manager; filters FactCMWorkerRoster by Id Employee. Start and termination dates relate to the report's auto date tables only.
table DimEmployees
	lineageTag: 4da4ecec-3244-4220-803b-da38b7004a0d

	/// Definition: Work location recorded for the employee.
	column Location
		dataType: string
		lineageTag: 4d328640-ba38-4a59-a030-bb682b217e17
		summarizeBy: none
		sourceColumn: Location

		annotation SummarizationSetBy = Automatic

	/// Definition: Employee's title, for example Ms or Mr.
	column Title
		dataType: string
		lineageTag: 4ef87a10-14bd-40d7-a12c-da3869bcd32c
		summarizeBy: none
		sourceColumn: Title

		annotation SummarizationSetBy = Automatic

