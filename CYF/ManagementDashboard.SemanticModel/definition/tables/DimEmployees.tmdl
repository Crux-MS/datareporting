		lineageTag: e1aa5d5f-11ba-4bdb-a6f9-cafbdf8e8b36
		summarizeBy: none
		sourceColumn: First Name

		annotation SummarizationSetBy = Automatic

	/// Definition: Employee's last name. Personal information.
	column 'Last Name'
		dataType: string
		lineageTag: d60e2570-7287-439d-b37c-9dd66cf346b7
		summarizeBy: none
		sourceColumn: Last Name

		annotation SummarizationSetBy = Automatic

