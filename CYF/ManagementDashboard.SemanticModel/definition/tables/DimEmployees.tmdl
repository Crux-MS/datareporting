		lineageTag: cad243c7-11d9-4b17-bcc9-8ca3e4e0d07c
		summarizeBy: none
		sourceColumn: Gender

		annotation SummarizationSetBy = Automatic

	/// Definition: Suburb recorded for the employee. Personal information.
