		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Definition: Date the employee's employment ended; blank while employed.
	/// For analysis: Relates to the report's auto date table only.
	column 'Termination Date'
		dataType: dateTime
		formatString: Long Date
		lineageTag: f453d88c-6c6a-4f39-96a3-28b63d7145da
