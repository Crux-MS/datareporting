		lineageTag: 78495e5a-7448-44ec-a916-aeeba76d0f43
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	/// Definition: Postcode recorded for the employee. Personal information.
	column Postcode
		dataType: string
		lineageTag: e69a69b2-0f0c-4ccd-87c2-ae203d046504
		summarizeBy: none
		sourceColumn: Postcode

		annotation SummarizationSetBy = Automatic

	/// Definition: Country recorded for the employee. Personal information.
	column Country
		dataType: string
		lineageTag: f78b0e41-39bf-4b66-9efb-7864cc4c397d
		summarizeBy: none
		sourceColumn: Country

		annotation SummarizationSetBy = Automatic

	/// Definition: Employee identifier from the HR system.
	/// For analysis: Key: joins FactCMWorkerRoster Id Employee.
	column 'Id Employee'
