table FactCMMonthlySnapshot
	lineageTag: dc64fd2c-b0c4-4a3f-a4e6-64d2c29bdab6

	measure LeavePaidMonthlyRate = DIVIDE(SUM(FactCMMonthlySnapshot[Payroll Leave Hours]), [TotalMonthlyHoursPaid])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Payroll
		lineageTag: 1c4066f0-8cfe-474e-a3a2-43ac1843a244

	measure TotalMonthlyHoursPaid = SUM(FactCMMonthlySnapshot[Payroll Standard Hours]) + SUM(FactCMMonthlySnapshot[Payroll Leave Hours]) + SUM(FactCMMonthlySnapshot[Payroll Overtime Hours]) + SUM(FactCMMonthlySnapshot[Payroll Other Hours])
		displayFolder: Payroll
		lineageTag: da249ad9-ccf9-4eff-8777-bab86a529248

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CountMonthlyActiveClients = SUM(FactCMMonthlySnapshot[Client Active Count])
		formatString: 0
		displayFolder: Clients
		lineageTag: 81e1ba28-0921-48ea-be79-78adbbcd2a35

	measure OvertimePaidMonthlyRate = DIVIDE(SUM(FactCMMonthlySnapshot[Payroll Overtime Hours]), [TotalMonthlyHoursPaid])
		displayFolder: Payroll
		lineageTag: 910bdbda-87ab-4779-b50c-d79715dacacc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

