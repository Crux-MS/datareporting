	measure MaxClientRollingTurnover =
			VAR _peakRate = CEILING(
			    SWITCH(
			        TRUE(),
			        SELECTEDVALUE(PeriodParam[WeeklyMonthlySelector Fields]) = "'DimDate'[Start of Month]", MAXX(VALUES(DimDate[Start of Month]), [ClientsRolling12MTurnover]),
			        SELECTEDVALUE ( PeriodParam[WeeklyMonthlySelector Fields] ) = "'DimDate'[Fortnight Start Date]", MAXX(VALUES(DimDate[Fortnight Start Date]), [ClientsRolling12MTurnover]),
			        SELECTEDVALUE(PeriodParam[WeeklyMonthlySelector Fields]) = "'DimDate'[Start of Week (Monday)]", MAXX(VALUES(DimDate[Start of Week (Monday)]), [ClientsRolling12MTurnover])
			    ),
			    0.05
			)
			VAR _logic = IF(_peakRate > 1, _peakRate, 1)
			RETURN _logic
		displayFolder: Clients
		lineageTag: 1dbe0c3f-2608-4206-a6af-9df37c1befba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition ParameterMeasures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

