table ParameterMeasures
	lineageTag: 6a5e55d0-543b-466c-a321-70bb7efbb9c1

	measure ClientsActiveCount = ```
			SWITCH(
			    SELECTEDVALUE(PeriodParam[WeeklyMonthlySelector Fields]),
			    "'DimDate'[Start of Month]", SUM(FactCMMonthlySnapshot[Client Active Count]), 
			    "'DimDate'[Fortnight Start Date]", SUM(FactCMFortnightlySnapshot[Client Active Count]),
			    "'DimDate'[Start of Week (Monday)]", SUM(FactCMWeeklySnapshot[Client Active Count])
			)
			```
		formatString: #,0
		displayFolder: Clients
		lineageTag: b065080a-1350-4e6c-896b-b0aaf955a94f

