table 'Date Granularity'
	lineageTag: 9fae33a6-d11f-4de4-ab88-f79a0ce2fcf1

	measure WeeksClarifier =
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('Date Granularity'[Date Granularity Fields]) = "'DimCalendar'[MMM YYYY]", BLANK(),
			    SELECTEDVALUE('Date Granularity'[Date Granularity Fields]) = "'DimCalendar'[StartOfWeek]", "N.B. Start of week date displayed",
			    SELECTEDVALUE('Date Granularity'[Date Granularity Fields]) = "'DimCalendar'[WorkDate]", BLANK()
			    )
		formatString: 0
		lineageTag: 093e2c2c-14ac-45c9-822e-1405f6b06f25

