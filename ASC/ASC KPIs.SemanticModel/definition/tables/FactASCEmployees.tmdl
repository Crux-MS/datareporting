	measure EstablishedBillableHours = ```
			VAR _currentDate = MAX(DimCalendar[WorkDate])
			VAR _periodStartDate = MIN(DimCalendar[WorkDate])
			VAR _establishedEndDate = (_periodStartDate - WEEKDAY(_periodStartDate, 1)+1)-28
			VAR _currentEmployees = CALCULATETABLE(
			    DISTINCT(DimASCEmployees[FullNameKey]),
			    CROSSFILTER(DimASCEmployees[id], FactASCEmployees[id], Both),
			    OR(DimEmploymentEndDate[EmploymentEndDate] >= _currentDate, DimEmploymentEndDate[EmploymentEndDate] = BLANK()),
			    FILTER(
			        ALL(DimCalendar[WorkDate]), 
			        DimCalendar[WorkDate] <= _currentDate &&
			        (DimCalendar[WorkDate] - WEEKDAY(DimCalendar[WorkDate], 1) +1) < _establishedEndDate
			    ))
			VAR _hours = CALCULATE(
			    SUM(FactCareViewCaseNotes[Hours]),
			    KEEPFILTERS(TREATAS(_currentEmployees, FactCareViewCaseNotes[EmployeeFullNameKey])),
			    FactCareViewCaseNotes[BillableFlag] = TRUE()
			)
			RETURN _hours 
			```
		displayFolder: Delivered Hours
		lineageTag: 335d667c-6354-4525-aeeb-18de565f447c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ApprovedLeave = ```
			VAR _currentDate = MAX(DimCalendar[WorkDate])
			VAR _currentEmployees = CALCULATETABLE(
			    DISTINCT(DimASCEmployees[id]),
			    CROSSFILTER(DimASCEmployees[id], FactASCEmployees[id], Both),
			    OR(DimEmploymentEndDate[EmploymentEndDate] >= _currentDate, DimEmploymentEndDate[EmploymentEndDate] = BLANK()),
			    FILTER(
			        ALL(DimCalendar[WorkDate]), 
			        DimCalendar[WorkDate] <= _currentDate
			    )
			)
			VAR _hours = CALCULATE(
			    SUM(FactASCKeyPayLeave[DailyHours]),
			    KEEPFILTERS(TREATAS(_currentEmployees, FactASCKeyPayLeave[employeeId]))
			)
			RETURN _hours 
			```
		formatString: #,0.0
		displayFolder: Available Hours
		lineageTag: 0fe6da66-8603-487f-bc15-9dfa7df252e2

