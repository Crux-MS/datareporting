	measure UnbillableHours = CALCULATE(SUM(FactCareViewCaseNotes[Hours]), FactCareViewCaseNotes[BillableFlag] = FALSE(), USERELATIONSHIP(BridgeEmployeeNames[fullName], FactCareViewCaseNotes[EmployeeFullNameKey]))
		formatString: #,0.0
		displayFolder: Delivered Hours
		lineageTag: ebeef158-8e2d-4c2d-907a-f02cf2d6536a

	measure PublicHolidayHours = ```
			VAR _currentDate = MAX(DimCalendar[WorkDate])
			VAR _currentEmployees = CALCULATETABLE(
			    DISTINCT(DimASCEmployees[FullNameKey]),
			    CROSSFILTER(DimASCEmployees[id], FactASCEmployees[id], Both),
			    OR(DimEmploymentEndDate[EmploymentEndDate] >= _currentDate, DimEmploymentEndDate[EmploymentEndDate] = BLANK()),
			    FILTER(
			        ALL(DimCalendar[WorkDate]), 
			        DimCalendar[WorkDate] <= _currentDate
			    ))
			VAR _publicHolidayPairs =
			    SUMMARIZE (
			        FILTER (
			            DimASCEmployeePublicHolidays,
			            DimASCEmployeePublicHolidays[PublicHolidayFlag] = TRUE ()
			        ),
			        DimASCEmployeePublicHolidays[FullNameKey],
			        DimASCEmployeePublicHolidays[date]
			    )
			VAR _hours = CALCULATE(
			    SUM(FactWorkerDailyStatus[Hours]),
			    KEEPFILTERS(TREATAS(_currentEmployees, FactWorkerDailyStatus[FullNameKey])),
			    KEEPFILTERS (
			        TREATAS (
			            _publicHolidayPairs,
			            FactWorkerDailyStatus[FullNameKey],
			            FactWorkerDailyStatus[Date]
			        )
			    )
			)
			RETURN _hours
			```
		formatString: #,0.0
		displayFolder: Available Hours
		lineageTag: 2b5d25c9-64c5-42de-95b5-15c0e387f64c

