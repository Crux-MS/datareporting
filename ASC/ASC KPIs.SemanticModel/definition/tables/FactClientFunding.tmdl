table FactClientFunding
	lineageTag: 1635ad1e-392d-4b55-98bb-6741b4d98ea5

	measure CountClientsVeryHighUnderspend = CALCULATE(DISTINCTCOUNT(FactClientFunding[NDIS Number]), FactClientFunding[VarianceCategory] = "Very High Underspend")
		formatString: #,0
		displayFolder: Counts
		lineageTag: b2518435-85ae-411d-b224-8ae40efa9a69

	measure CountClientsVeryHighOverspend = CALCULATE(DISTINCTCOUNT(FactClientFunding[NDIS Number]), FactClientFunding[VarianceCategory] = "Very High Overspend")
		formatString: #,0
		displayFolder: Counts
		lineageTag: 56ececf9-18f1-4351-b0cc-94312c7f4845

	measure CountCurrentServicePlans = ```
			VAR _currentDate = MAX(DimCalendar[WorkDate])
			VAR _currentPlans = CALCULATETABLE(
			    DISTINCT(FactClientFunding[NDIS Number]),
			    // CROSSFILTER(FactClientFunding[FullNameKey], BridgeCareViewClients[ClientFullNameKey], Both),
			    FactClientFunding[NDIS Plan Start Date] >= _currentDate || FactClientFunding[NDIS Plan End Date] = BLANK(),
			    FILTER(
			        ALL(DimCalendar[WorkDate]), 
			        DimCalendar[WorkDate] <= _currentDate
			    ))
			VAR _hours = CALCULATE(
			    COUNT(FactClientFunding[Service Contract Reference No.]),
			    KEEPFILTERS(TREATAS(_currentPlans, FactClientFunding[FullNameKey]))
			)
			RETURN _hours
			```
		formatString: 0
		displayFolder: Counts
		lineageTag: 9186714c-6c23-4d60-a1c2-ebd538c4ba47

	measure MaxRiskCategory =
			VAR _maxVarianceCategoryOrder = MAX(FactClientFunding[VarianceCategoryOrder])
			RETURN CALCULATE(SELECTEDVALUE(FactClientFunding[VarianceCategory]), FactClientFunding[VarianceCategoryOrder] = _maxVarianceCategoryOrder)
		lineageTag: 6b09a8a4-6880-4131-bb69-5efd73b20c7f

