	measure DisplayTotalContractValue =
			
			IF (
			    ISINSCOPE (FactClientFunding[Date created]),
			        // Expanded date row: the actual value for that export
			        SUM ( FactClientFunding[Total Service Contract Value] ),
			        // Collapsed client row OR grand total: latest export only.
			        // KEEPFILTERS so the client context on the parent row is preserved;
			        // at the grand total this naturally sums each client's latest row.
			        CALCULATE (
			            SUM ( FactClientFunding[Total Service Contract Value] ),
			            KEEPFILTERS ( FactClientFunding[ClientLatestExportFlag] = 0 )
			        )
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 01be9a30-c146-4c82-98f3-53f7533a4757

	measure DisplayFundsRemainingRate =
			
			IF (
			    ISINSCOPE ( FactClientFunding[Date created] ),
			        SELECTEDVALUE ( FactClientFunding[FundsRemainingRate] ),
			        // Client row: the latest export's rate (one row, so this is exact).
			        // Grand total: this returns the rate over the pooled latest rows, whose
			        // correctness depends on how FundsRemainingRate is defined — confirm.
			        CALCULATE (
			            SELECTEDVALUE ( FactClientFunding[FundsRemainingRate] ),
			            KEEPFILTERS ( FactClientFunding[ClientLatestExportFlag] = 0 )
			        )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2a1c35a1-55f1-48cd-ab95-0664562d7a8c

