				                "ClientLatestExportFlag", 0, 1, Int64.Type), 
				                type table [Full Name=nullable text, NDIS Number=nullable text, Client Status=nullable text, #"Service Contract Reference No."=nullable text, Service Contract Status=nullable text, NDIS Plan Start Date=nullable date, NDIS Plan End Date=nullable date, Total Service Contract Value=nullable number, Total Delivered=nullable number, Total Remaining=nullable number, Service Contract Category=nullable text, Date created=nullable date, FullNameKey=text, PlanDuration=nullable number, CurrentDuration=nullable number, PlanEndPassedFlag=nullable logical, PlanDurationCompletedRate=nullable number, PlanDurationRemainingRate=nullable number, FundsRemainingRate=nullable number, FundsDeliveredRate=nullable number, RiskRateVariance=nullable number, VarianceCategory=nullable text, VarianceCategoryOrder=nullable number, ClientLatestExportFlag=number]}),
