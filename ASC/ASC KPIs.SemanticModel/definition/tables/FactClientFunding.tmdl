				    #"Added CurrentDuration" = Table.AddColumn(#"Added PlanDuration", "CurrentDuration", each Duration.Days(DateTime.Date([Date created]) - [NDIS Plan Start Date])),
				    #"Added PlanEndPassedFlag" = Table.AddColumn(#"Added CurrentDuration", "PlanEndPassedFlag", each if [NDIS Plan End Date] >= [Date created] then false else true),
				    #"Added PlanDurationCompletedRate" = Table.AddColumn(#"Added PlanEndPassedFlag", "PlanDurationCompletedRate", each if [PlanEndPassedFlag] = false then [CurrentDuration]/[PlanDuration] else [PlanDuration]/[PlanDuration]),
				    #"Added PlanDurationRemainingRate" = Table.AddColumn(#"Added PlanDurationCompletedRate", "PlanDurationRemainingRate", each 1-[PlanDurationCompletedRate]),
				    #"Added FundsRemainingRate" = Table.AddColumn(#"Added PlanDurationRemainingRate", "FundsRemainingRate", each [Total Remaining]/[Total Service Contract Value]),
				    #"Added FundsDeliveredRate" = Table.AddColumn(#"Added FundsRemainingRate", "FundsDeliveredRate", each [Total Delivered]/[Total Service Contract Value]),
				    #"Added RiskRateVariance" = Table.AddColumn(#"Added FundsDeliveredRate", "RiskRateVariance", each [FundsRemainingRate]-[PlanDurationRemainingRate]),
				    #"Added VarianceCategory" = Table.AddColumn(#"Added RiskRateVariance", "VarianceCategory", each if [RiskRateVariance] <= -0.4 then "Very High Overspend" else if [RiskRateVariance] < -0.2 then "High Overspend" else if [RiskRateVariance] < 0.2 then "Within Target" else if [RiskRateVariance] < 0.4 then "High Underspend" else if [RiskRateVariance] >= 0.4 then "Very High Underspend" else null),
				    #"Added VarianceCategoryOrder" = Table.AddColumn(#"Added VarianceCategory", "VarianceCategoryOrder", each if [RiskRateVariance] <= -0.4 then 1 else if [RiskRateVariance] < -0.2 then 2 else if [RiskRateVariance] < 0.2 then 3 else if [RiskRateVariance] < 0.4 then 4 else if [RiskRateVariance] >= 0.4 then 5 else 6),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added VarianceCategoryOrder",{{"PlanDuration", Int64.Type}, {"CurrentDuration", Int64.Type}, {"FundsRemainingRate", Percentage.Type}, {"RiskRateVariance", type number}, {"PlanDurationCompletedRate", Percentage.Type}, {"FundsDeliveredRate", Percentage.Type}, {"PlanDurationRemainingRate", Percentage.Type}, {"VarianceCategory", type text}, {"VarianceCategoryOrder", Int64.Type}, {"PlanEndPassedFlag", type logical}}),
				    #"Grouped Rows" = Table.Group(#"Changed Type", {"NDIS Number"}, {{"AllRows", each _, type table [Full Name=nullable text, NDIS Number=nullable text, Client Status=nullable text, #"Service Contract Reference No."=nullable text, Service Contract Status=nullable text, NDIS Plan Start Date=nullable date, NDIS Plan End Date=nullable date, Total Service Contract Value=nullable number, Total Delivered=nullable number, Total Remaining=nullable number, Service Contract Category=nullable text, Date created=nullable date, FullNameKey=text, PlanDuration=nullable number, CurrentDuration=nullable number, PlanEndPassedFlag=nullable logical, PlanDurationCompletedRate=nullable number, PlanDurationRemainingRate=nullable number, FundsRemainingRate=nullable number, FundsDeliveredRate=nullable number, RiskRateVariance=nullable number, VarianceCategory=nullable text, VarianceCategoryOrder=nullable number]}}),
				    #"Added ClientLatestExportFlag" = #"Table.TransformColumns"(
