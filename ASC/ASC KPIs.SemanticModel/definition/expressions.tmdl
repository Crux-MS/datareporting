		                [toDate]-[fromDate]
		            ) + 1, 
		            #duration(1,0,0,0)
		        ), 
		        each Date.DayOfWeek(_,1) < 5
		    )
		)),
		    #"Inserted Multiplication" = Table.AddColumn(#"Added CountWorkDays", "DailyHours", each [totalHours] / [CountWorkDays], type number)
		in
		    #"Inserted Multiplication"
		```
