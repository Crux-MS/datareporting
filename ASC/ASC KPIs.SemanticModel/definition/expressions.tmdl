		    #"Inserted Day Number" = Table.AddColumn(#"Inserted YYYYMM", "DayNumber", each Date.Day([Date]), Int64.Type),
		    #"Inserted Day Name" = Table.AddColumn(#"Inserted Day Number", "DayName", each Date.DayOfWeekName([Date]), type text),
		    #"Inserted Day of Week" = Table.AddColumn(#"Inserted Day Name", "DayOfWeek", each Date.DayOfWeek([Date]), Int64.Type),
		    #"Inserted Start of Week" = Table.AddColumn(#"Inserted Day of Week", "StartOfWeek", each Date.StartOfWeek([Date]), type date),
		    #"Inserted Start of Year" = Table.AddColumn(#"Inserted Start of Week", "StartOfYear", each Date.StartOfYear([Date]), type date),
		    #"Inserted Week of Year" = Table.AddColumn(#"Inserted Start of Year", "WeekOfYear", each Date.WeekOfYear([Date]), Int64.Type),
		    #"Added Week of Month" = Table.AddColumn(#"Inserted Week of Year", "WeekOfMonth", each if [DayNumber] > 28 then 5 else if [DayNumber] > 21 then 4 else if [DayNumber] > 14 then 3 else if [DayNumber] > 7 then 2 else if [DayNumber] >= 1 then 1 else null),
		    #"Added Rolling Date Difference" = Table.AddColumn(#"Added Week of Month", "RollingDateDifference", each Duration.Days([Date] - Date.From(DateTime.LocalNow()))),
		    #"Added Slicer MMM YYYY" = Table.AddColumn(#"Added Rolling Date Difference", "Slicer MMM YYYY", each let
		    currentMonthYear = List.First(
		        Table.SelectRows(#"Added Rolling Date Difference", each [RollingDateDifference] = 0)[MMM YYYY]
		    )
		in
		    if [MMM YYYY] = currentMonthYear then "Current Month" else [MMM YYYY]),
		    #"Added Slicer Start of Week" = Table.AddColumn(#"Added Slicer MMM YYYY", "Slicer StartOfWeek", each let
		    currentMonthYear = List.First(
		        Table.SelectRows(#"Added Rolling Date Difference", each [RollingDateDifference] = 0)[StartOfWeek]
		    )
		in
		    if [StartOfWeek] = currentMonthYear then "Current Week" else [StartOfWeek]),
		    #"Added FortnightOfYear" = Table.AddColumn(#"Added Slicer Start of Week", "FortnightOfYear", each Number.RoundUp(Date.DayOfYear([Date])/14)),
		    #"Added YYYYFF" = Table.AddColumn(#"Added FortnightOfYear", "YYYYFF", each if [FortnightOfYear] <= 9 then Text.From([Year]) & "0" & Text.From([FortnightOfYear]) else Text.From([Year]) & Text.From([FortnightOfYear])),
		    #"Added FF (DD MMM YYYY)" = Table.AddColumn(#"Added YYYYFF", "FF (DD MMM YYYY)", each 
		let 
		   DaysSinceStart = Duration.Days([Date] - [StartOfYear]),
		   FortnightStartDate = Date.AddDays([StartOfYear], ([FortnightOfYear] - 1) * 14),
		   AdjustedStartDate = if FortnightStartDate > [Date] then Date.AddDays(FortnightStartDate, -14) else FortnightStartDate,
		   MonthAbbrev = Date.ToText(AdjustedStartDate, "dd MMM yyyy"),
		   FFLabel = Text.From([FortnightOfYear]) & " (" & MonthAbbrev & ")"
		in
		  FFLabel),
		    StartDate = List.Min(Source),
