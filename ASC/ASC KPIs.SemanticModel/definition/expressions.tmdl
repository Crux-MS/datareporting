expression 'EH Payroll Leave Function' = ```
		let
		    Source = (startdate as date) =>
		    let
		        fromDate = Date.ToText(startdate, "yyyy-MM-dd"),
		        toDate = Date.ToText(startdate, "yyyy-MM-dd"),// ,+#duration(0,23,59,99), "yyyy-MM-dd"),
		        apiUrl = "https://api.yourpayroll.com.au/api/v2/business/325716/leaverequest",
		        headers = [#"Authorization"=#"KeyPay API Authorisation String"],
		        apiQuery = [
		            filter.fromDate=fromDate, 
		            filter.toDate=toDate, 
		            filter.status="Approved", filter.restrictOverlappingLeave="True"],
		        source = Json.Document(Web.Contents(apiUrl, [Query=apiQuery, Headers=headers]))
		    in
		        source
		in
		    Source
		```
