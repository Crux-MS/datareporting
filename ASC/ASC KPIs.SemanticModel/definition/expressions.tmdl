		    Custom1 = Table.AddColumn(#"Renamed Columns", "Custom", each #"EH Payroll Leave Function"([leaveDate])),
		    #"Expanded Custom" = Table.ExpandListColumn(Custom1, "Custom"),
		    #"Filtered Rows1" = Table.SelectRows(#"Expanded Custom", each ([Custom] <> null)),
		    #"Expanded Custom1" = Table.ExpandRecordColumn(#"Filtered Rows1", "Custom", {"totalHours", "hoursApplied", "id", "employeeId", "leaveCategoryId", "employee", "leaveCategory", "fromDate", "toDate", "notes", "status", "attachmentId"}, {"totalHours", "hoursApplied", "id", "employeeId", "leaveCategoryId", "employee", "leaveCategory", "fromDate", "toDate", "notes", "status", "attachmentId"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Expanded Custom1",{{"fromDate", type datetime}, {"toDate", type datetime}, {"leaveDate", type date}}),
		    #"Added CountWorkDays" = Table.AddColumn(#"Changed Type", "CountWorkDays", each List.Count(
		    List.Select(
		        List.Dates(
		            Date.From([fromDate]), 
