		    #"Added Conditional Column" = Table.AddColumn(Source, "nurse_age_band_sorting", each if [nurse_age_band] = "Under 21" then 0 else if [nurse_age_band] = "21-34" then 1 else if [nurse_age_band] = "35-49" then 2 else if [nurse_age_band] = "50+" then 4 else 5),
