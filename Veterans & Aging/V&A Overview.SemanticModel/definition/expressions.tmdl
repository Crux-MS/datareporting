		    #"Added Rolling Date Difference" = Table.AddColumn(#"Inserted Start of Year", "RollingDateDifference", each Duration.Days([Date] - Date.From(DateTime.LocalNow()))),
		    #"Added Slicer MMM YYYY" = Table.AddColumn(#"Added Rolling Date Difference", "Slicer MMM YYYY", each let
		    currentMonthYear = List.First(
		        Table.SelectRows(#"Added Rolling Date Difference", each [RollingDateDifference] = 0)[MMM YYYY]
		    )
