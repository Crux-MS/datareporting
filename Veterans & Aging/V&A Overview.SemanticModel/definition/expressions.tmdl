		    Source = Odbc.Query(#"Saturn NSW/ACT Connection string", "select #(lf)CAST(nurse_id AS VARCHAR(6))#(lf),firstname#(lf),surname#(lf),COALESCE(firstname, '') + ' ' + COALESCE(surname, '') AS fullname#(lf),suburb AS nurse_suburb#(lf),state AS nurse_state#(lf),postcode AS nurse_postcode#(lf),country#(lf),CASE#(lf)WHEN gender_id = 2 THEN 'Female'#(lf)WHEN gender_id = 3 THEN 'Male'#(lf)WHEN gender_id = 1 THEN 'Not Specified'#(lf)END AS gender#(lf),CASE #(lf)WHEN DATEDIFF(year, date_of_birth, GETDATE()) < 21 THEN 'Under 21'#(lf)WHEN DATEDIFF(year, date_of_birth, GETDATE()) >= 21 AND DATEDIFF(year, date_of_birth, GETDATE()) <35 THEN '21-34'#(lf)WHEN DATEDIFF(year, date_of_birth, GETDATE()) >=35 AND DATEDIFF(year, date_of_birth, GETDATE()) <50 THEN '35-49'#(lf)WHEN DATEDIFF(year, date_of_birth, GETDATE()) >= 50 THEN '50+'#(lf)ELSE 'DOB Not Specified'#(lf)END AS nurse_age_band#(lf),CAST(drivers_licence_ind AS BIT)#(lf),CAST(#(lf)CASE #(lf)WHEN drivers_licence_expiry < GETDATE() THEN 0#(lf)WHEN drivers_licence_expiry IS NULL THEN 0#(lf)ELSE 1#(lf)END AS BIT) AS drivers_licence_current_ind#(lf),CAST(CASE #(lf)WHEN car_registration_expiry < GETDATE() THEN 0#(lf)WHEN car_registration_expiry IS NULL THEN 0#(lf)ELSE 1#(lf)END AS BIT) AS car_registration_current_ind#(lf),CAST(CASE #(lf)WHEN car_insurance_expiry < GETDATE() THEN 0#(lf)WHEN car_insurance_expiry IS NULL THEN 0#(lf)ELSE 1#(lf)END AS BIT) AS car_insurance_current_ind#(lf),CAST(own_vehicle_ind AS BIT)#(lf),CAST(induction_ind AS BIT)#(lf),CAST(sub_contractor_ind AS BIT)#(lf),CAST(smoker_ind AS BIT)#(lf),CAST(manual_handling_ind AS BIT)#(lf),CAST(CASE WHEN active_ind = 'Y' THEN 1 WHEN active_ind = 'N' then 0 END AS BIT) AS active_ind#(lf)from dba.nurse#(lf)where test_nurse_ind <> 1"),
		    #"Added Conditional Column" = Table.AddColumn(Source, "nurse_age_band_sorting", each if [nurse_age_band] = "Under 21" then 0 else if [nurse_age_band] = "21-34" then 1 else if [nurse_age_band] = "35-49" then 2 else if [nurse_age_band] = "50+" then 4 else 5),
