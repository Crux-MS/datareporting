table FactPatient
	lineageTag: dd52d711-e1bf-4c22-bd9a-d701bb573475

	measure CountPatients =
			CALCULATE(
			    DISTINCTCOUNT(FactPatient[patient_id]),
			    CROSSFILTER(FactVisit[patient_id], DimPatient[patient_id], Both),
			    CROSSFILTER(DimPatientStartDate[Date], FactPatient[care_start_date],Both))
		formatString: #,0
		lineageTag: 0bf14d7a-7c28-4309-a5bf-9ebe3936598e

	measure CountCurrentlyActivePatients =
			VAR _periodEnd = CALCULATE(MAX(DimPatientStartDate[Date]), CROSSFILTER(DimPatientStartDate[Date], FactPatient[care_start_date], Both), CROSSFILTER(DimPatient[patient_id], FactVisit[patient_id], Both))
			VAR _activePatients = CALCULATE(
			    [CountPatients],
			    KEEPFILTERS(DimPatient[active_ind] = "Active"),
			    FILTER(
			        ALLEXCEPT(FactPatient, DimPatient[patient_state]),
			        FactPatient[care_start_date] <= _periodEnd &&
			        (FactPatient[care_end_date] >= _periodEnd || FactPatient[care_end_date] = BLANK()))
			)
			RETURN _activePatients
		formatString: #,0
		lineageTag: 2873f74f-6295-4852-9b7a-3489ebed78b7

	measure CountReferralInstances = DISTINCTCOUNT(FactPatient[referrer_id])
		formatString: 0
		lineageTag: 61a46193-72fb-41b4-80c5-07851880d21c

	measure FirstReferralDate = MIN(FactPatient[referral_date])
		formatString: Short Date
		lineageTag: 14e762ce-0ce8-4800-9d3d-432778f9eb59

	measure CareInitiallyStarted = MIN(FactPatient[care_start_date])
		formatString: Short Date
		lineageTag: 74558eb4-0a2e-4c19-b51e-779f67b70d85

	measure CountBilledPatients = CALCULATE([CountPatients], FactVisit[status] = "Completed")
		formatString: #,0
		lineageTag: 657a4896-a4e7-4f7d-9c1d-4baad3bd6b39

