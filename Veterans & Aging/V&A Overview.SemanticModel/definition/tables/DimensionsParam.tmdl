			        "'DimFundingStreams'[FundingStream]", "Billed clients by funding stream")
		lineageTag: 83816a77-cb6d-413a-b869-7157ebb6e3c8

	measure DisplayActivePatients =
			SWITCH(
			    SELECTEDVALUE(
			        DimensionsParam[Parameter Fields]),
			        "'DimAustralianStates'[Acronym]", SUM(FactStateActivePatients[CountPatients]),
			        "'DimFundingStreams'[FundingStream]", SUM(FactServicesActivePatients[ActivePatients]))
		formatString: #,0
		lineageTag: 567703bd-43e2-4b1b-bbbe-3f950a3e48d5

