table DimensionsParam
	lineageTag: f28bd313-ef4e-4d34-8418-ad9b8fb3ec4f

	measure VisitsParamTitle =
			SWITCH(
			    SELECTEDVALUE(
			        DimensionsParam[Parameter Fields]),
			        "'DimAustralianStates'[Acronym]", "Visits by patient residential state",
			        "'DimFundingStreams'[FundingStream]", "Visits by funding stream")
		lineageTag: 59b98253-4e69-4251-b3ad-086ea0416acb

	measure ActiveClientsParamTitle =
			SWITCH(
			    SELECTEDVALUE(
