table DimPatientStartDate
	lineageTag: 93154704-5a96-483e-a64a-32804db1561f
	dataCategory: Time

	measure 'Patient Reporting Year Flag' =
			VAR _selectedDate = CALCULATE(MAX('DimPatientStartDate'[Date]))//, CROSSFILTER(DimPatientStartDate[Date], FactPatient[care_start_date], Both))
			VAR _startDate = EOMONTH(_selectedDate, -12)+1
			VAR _endDate = EOMONTH(_selectedDate, 0)
			VAR _selectedStartDate = MAX(DimPatientStartDate[Date])
			VAR _logic = IF(_selectedStartDate >= _startDate && _selectedStartDate <= _endDate,
			    1,
			    0)
			RETURN _logic
		formatString: 0
		lineageTag: 2444279d-c2a4-4cec-bbd3-cebef2a273a9

