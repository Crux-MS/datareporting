table FactVisit
	lineageTag: baa6fd1f-a2c0-4943-b847-9aaa86f193d3

	measure CountVisits =
			CALCULATE(
			    COUNT(FactVisit[visit_id]),
			    CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		displayFolder: Counts
		lineageTag: eb0719aa-0897-4e91-8770-9c7741104a3d

	measure LatestCompletedVisitDate = CALCULATE(MAX(FactVisit[visit_date]), FactVisit[status] = "Completed")
		formatString: Short Date
		displayFolder: Dates/Times
		lineageTag: 7a9ec646-0601-4077-a31e-6a52e5c00f88

	measure CountCompletedVisits = CALCULATE([CountVisits], FactVisit[status] = "Completed", CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		displayFolder: Counts
		lineageTag: 34a7e31a-f86e-40e5-8309-1fc9a954d5e6

	measure TravelTimeToNextHrs = CALCULATE(DIVIDE(SUM(FactVisit[travel_time_to_next]), 60), CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		displayFolder: Duration
		lineageTag: ffbd316b-192f-45bd-ac71-8dfc96dfeb5f

		annotation PBI_FormatHint = {"isDecimal":true}

	measure AvgVisitDuration = CALCULATE(AVERAGE(FactVisit[visit_duration]),CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		displayFolder: Duration
		lineageTag: 4b9e279a-0d9b-46e7-b982-54328c9d4f7b

		annotation PBI_FormatHint = {"isDecimal":true}

	measure TotalDistanceToNext =
			CALCULATE(
			    SUM(FactVisit[distance_to_next]),
			    CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		lineageTag: ad373d6f-3d68-44ab-8ff7-84cb32329dc4

		annotation PBI_FormatHint = {"isDecimal":true}

	measure TotalCopaymentDue =
			CALCULATE(
			    SUM(FactVisit[co_payment_due]),
			    CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Dollars
		lineageTag: f98d1cd5-688c-4da8-a7d1-bff839f824dc

	measure TotalCopaymentReceived =
			CALCULATE(
			    SUM(FactVisit[co_payment_received]),
			    CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Dollars
		lineageTag: 01fc5a45-79ad-4139-a506-ffd93dd15b05

	measure EarliestVisitDate = CALCULATE(MIN(FactVisit[visit_date]))
		formatString: Short Date
		displayFolder: Dates/Times
		lineageTag: dc0f3033-5055-4bd2-8e4d-7d68dab569a6

	measure CountVisitsWithTravel = CALCULATE([CountVisits], FactVisit[travel_time_to_next] > 0 || FactVisit[travel_time_to_next] <> BLANK())
		formatString: #,0
		displayFolder: Counts
		lineageTag: 2baebea8-affa-4cb0-8417-76cf272dffa4

	measure CountVisitPatients =
			CALCULATE(
			    DISTINCTCOUNT(FactVisit[patient_id]),
			    CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: 0
		displayFolder: Counts
		lineageTag: f61d9381-a650-4e40-afbf-eb1e219b02ba

	measure ServicePlanNumber = CALCULATE(SELECTEDVALUE(DimPatientServicePlans[Service Plan Number]), CROSSFILTER(BridgeDVANumber[dva_number], DimPatientServicePlans[DVA file number], Both))
		formatString: 0
		lineageTag: 99b248b5-59d0-4f69-90b3-c5368ba0a968

	measure CountCancelledVisits = CALCULATE([CountVisits], FactVisit[status] = "Cancelled", CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		displayFolder: Counts
		lineageTag: 76047d03-2d4a-41e1-bfe9-5e00ee428b2b

	measure CountNewVisits = CALCULATE([CountVisits], FactVisit[status] = "New Visit", CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		displayFolder: Counts
		lineageTag: 7fc40025-8b71-4c88-aceb-a9e1bef780bb

	measure CountOnHoldVisits = CALCULATE([CountVisits], FactVisit[status] = "On Hold", CROSSFILTER(FactPatient[patient_id], DimPatient[patient_id], Both))
		formatString: #,0
		displayFolder: Counts
		lineageTag: 076c1164-b70b-43ef-b1fd-3ce69f12a894

	measure VisitDVANumber = CALCULATE(MAX(FactPatient[dva_number]))
		lineageTag: 917d5a3b-4ea6-47d3-b035-c14c0b0d43a6

	measure CountUncompletedVisits = [CountCancelledVisits] + [CountNewVisits] + [CountOnHoldVisits]
		formatString: #,0
		displayFolder: Counts
		lineageTag: 44da7b04-b48f-4f0a-b9f9-3054c9a177bd

	measure CountVisitsNoDVANumber = CALCULATE([CountVisits], FactPatient[dva_number] = BLANK() || FactPatient[dva_number] = "." || FactPatient[dva_number] = ",")
		formatString: #,0
		displayFolder: Counts
		lineageTag: 86968b66-f0b3-43c3-a786-551addadb3db

