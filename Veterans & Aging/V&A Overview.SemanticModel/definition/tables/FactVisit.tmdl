	column VHCReference =
			VAR _visitDate = INT(FactVisit[visit_date])
			VAR _fullPatientID = FactVisit[patient_id]
			VAR _patientId = RIGHT(_fullPatientID, 4)
			VAR _patienRawState = CALCULATE(SELECTEDVALUE(DimPatient[patient_state]))
			VAR _state = CALCULATE(LEFT(MAX(DimPatient[patient_state]),1), DimPatient[patient_id] = _fullPatientID)
			VAR _serviceType = CALCULATE(MAX(DimServiceTypes[ServiceType]), CROSSFILTER(DimServiceTypes[service_id], FactVisit[service_type_id], Both))
			RETURN _state & _visitDate & _patientId & _serviceType
		lineageTag: 552c2836-8801-457c-839f-48bbecaa6148
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

