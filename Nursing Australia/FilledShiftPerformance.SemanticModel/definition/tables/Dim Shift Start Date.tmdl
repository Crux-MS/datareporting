table 'Dim Shift Start Date'
	lineageTag: 959a324b-3c68-48db-a255-1864a7fee8b2
	sourceLineageTag: 04baa92e-d6a6-4b28-bac7-b8933f0c17fa

	measure SelectedDateRange = FORMAT(MIN('Dim Shift Start Date'[ShiftStartDate]), "DD/MM/YYYY") & " - " & FORMAT(MAX('Dim Shift Start Date'[ShiftStartDate]), "DD/MM/YYYY")
		lineageTag: 6e526654-523c-4574-866a-96e85f72148f

		changedProperty = Name

	measure SelectedDatesLastMonth =
			VAR _lastMonthIndicator = CALCULATE(MIN('Dim Shift Start Date'[RollingDateDifference]), 'Dim Shift Start Date'[SlicerMMM YYYY] = "Current Month")-1
			VAR _lastMonth = CALCULATE(FORMAT(MAX('Dim Shift Start Date'[ShiftStartDate]), "DD/MM/YYYY"), 'Dim Shift Start Date'[RollingDateDifference] = _lastMonthIndicator)
			VAR _startDate = CALCULATE(FORMAT(STARTOFMONTH('Dim Shift Start Date'[ShiftStartDate]), "DD/MM/YYYY"), 'Dim Shift Start Date'[RollingDateDifference] = _lastMonthIndicator)
			VAR _logic = _startDate & " - " & _lastMonth
			RETURN _logic
		lineageTag: ce300f48-942d-4bf5-81a4-a926a3d1c381

		changedProperty = Name

	measure MaxDate = FORMAT(MAX('Dim Shift Start Date'[ShiftStartDate]), "DD/MM/YYYY")
		lineageTag: 2d8b00b1-8e50-47fb-be35-6bbd48223785

		changedProperty = Name

