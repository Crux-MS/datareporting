	measure FilledShiftsLastMonth =
			VAR _lastMonthIndicator = CALCULATE(MIN('Dim Shift Start Date'[RollingDateDifference]), 'Dim Shift Start Date'[SlicerMMM YYYY] = "Current Month")-1
			VAR _lastMonth = CALCULATE(MAX('Dim Shift Start Date'[MMM YYYY]), 'Dim Shift Start Date'[RollingDateDifference] = _lastMonthIndicator)
			VAR _logic = CALCULATE([FilledShiftHours], 'Dim Shift Start Date'[MMM YYYY] = _lastMonth)
			RETURN _logic
		lineageTag: 456cf0ee-69cd-4980-8e9f-8739f59dac8c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AvailableShiftFillRateRemainder = 1-[AvailableOpportunityFilledRate]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 24c9b743-a4be-489c-9750-8ade41c3506e

		changedProperty = Name

		changedProperty = FormatString

	measure DailyTarget = 550
		formatString: 0
		lineageTag: a5f54c60-2157-46a6-85a4-4f09a2fa194b

		changedProperty = Name

	measure periodTarget = ```
			[DailyTarget] *  IF(
			    DATEDIFF(MIN('Dim Shift Start Date'[ShiftStartDate]), MAX('Dim Shift Start Date'[ShiftStartDate]),DAY) = 0, 
			    1, 
			    DATEDIFF(MIN('Dim Shift Start Date'[ShiftStartDate]), MAX('Dim Shift Start Date'[ShiftStartDate]),DAY)
			)
			```
		formatString: #,0
		lineageTag: 22f02523-5256-4424-82d1-d44361b600c8

		changedProperty = Name

		changedProperty = FormatString

	measure RemainderPeriodTarget = [periodTarget] - [FilledShiftHours]
		lineageTag: 67946c56-ca85-4e1f-9210-723c9bb57091

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ShiftTargetRemainderIndicatorArrows = ```
			
			VAR _remainderTarget = [RemainderPeriodTarget]
			VAR UpArrow = UNICHAR(9650)
			VAR DownArrow = UNICHAR(9660)
			VAR Result = SWITCH(TRUE, 
			     _remainderTarget = 0, "",
			     _remainderTarget < 0, UpArrow, 
			    DownArrow
			)
			
			RETURN Result  
			```
		lineageTag: db10ea9c-478a-400a-bb71-08ba928a60ad

		changedProperty = Name

