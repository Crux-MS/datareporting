expression 'DirectQuery to AS - Nursing Australia Overview' =
		let
		    Source = AnalysisServices.Database("powerbi://api.powerbi.com/v1.0/myorg/Nursing%20Australia", "Nursing Australia Overview"),
		    Cubes = Table.Combine(Source[Data]),
		    Cube = Cubes{[Id="Model", Kind="Cube"]}[Data]
