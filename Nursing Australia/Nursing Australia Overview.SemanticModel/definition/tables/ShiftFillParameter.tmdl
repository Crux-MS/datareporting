table ShiftFillParameter
	lineageTag: b789383c-1dbc-4981-98d1-db5f5d483a9b

	measure ShiftFillParameterTopNFlag =
			SWITCH(TRUE(),
			    SELECTEDVALUE(ShiftFillParameter[Parameter Fields]) = "'Fact Shift'[UTFShiftNoLongerRequiredHours]", [UTFShiftNoLongerRequiredHours],
			    SELECTEDVALUE(ShiftFillParameter[Parameter Fields]) = "'Fact Shift'[UTFShiftStillNeededHours]", [UTFShiftStillNeededHours],
			    SELECTEDVALUE(ShiftFillParameter[Parameter Fields]) = "'Fact Shift'[FilledShiftHours]", [FilledShiftHours]
			    )
		formatString: #,0.00
		lineageTag: bf41f6a6-9ded-4bd6-9eed-3eb22a21582c

