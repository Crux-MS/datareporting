	partition 'Dim Shift Allocation' = m
		mode: import
		queryGroup: Shifts
		source =
				let
				    Source = Sql.Database("10.2.0.5\azhrinkuat,50660", "HRLink", [Query="SELECT [MemberInteractionID]#(lf)      ,mi.[ShiftID]#(lf)      ,mi.[MemberID]#(lf)      ,mi.[AgencyID]#(lf)      ,it.Description                   AS [InteractionType]#(lf)      ,im.Description                   AS [InteractionMethod]#(lf)      ,ints.Name                        AS [interactionInstigator]#(lf)      ,mi.UserName#(lf)      ,u.GivenName + ' ' + u.Surname    AS [User]#(lf)      ,u.EmailAddress                   AS [UserEmail]#(lf)      ,[Time]#(lf)  FROM [HRLink].[dbo].[MemberInteraction] mi#(lf)  LEFT JOIN dbo.InteractionType it on it.InteractionTypeID = mi.InteractionTypeID#(lf)  LEFT JOIN dbo.InteractionInstigator ints  on ints.InteractionInstigatorID = mi.InteractionInstigatorID#(lf)  LEFT JOIN dbo.InteractionMethod im ON im.InteractionMethodID = mi.InteractionMethodID#(lf)  LEFT JOIN dbo.Shift s on s.ShiftID = mi.ShiftID#(lf)  LEFT JOIN dbo.[User] u on u.Username = mi.UserName#(lf)  where mi.AgencyID = 4 and s.StartDate >= DATEADD(year,-3,GETDATE())"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

