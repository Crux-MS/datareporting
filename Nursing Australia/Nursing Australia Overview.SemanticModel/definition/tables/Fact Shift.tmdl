	partition 'Fact Shift' = m
		mode: import
		queryGroup: Shifts
		source =
				let
				    Source = Sql.Database("10.2.0.5\azhrinkuat,50660", "HRLink", [Query="SELECT#(lf)#(tab)s.ShiftId#(lf)#(tab),s.AgencyID#(lf)#(tab),s.ClientId#(lf)#(tab),s.MemberID#(lf)#(tab),s.InvoiceID#(lf)#(tab),s.PayslipID#(lf)#(tab),s.CampusId#(lf)#(tab),s.StartDate#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS [StartDateTime]#(lf)#(tab),s.FinishDate#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS [FinishDateTime]#(lf)#(tab),CAST(s.StartDate AS DATE)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS [StartDate]#(lf)#(tab),CAST(s.FinishDate AS DATE)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS [FinishDate]#(lf)#(tab),DATEDIFF(MINUTE, s.StartDate, s.FinishDate)#(tab)AS [TotalShiftDurationMins]#(lf)#(tab),DATEDIFF(MINUTE, s.StartDate, s.FinishDate) - s.MealBreakTime#(tab)AS [ShiftWorkedDurationMins]#(lf)#(tab),s.PayHrsPaid1#(lf)#(tab),s.PayRate1#(lf)#(tab),s.PayAmount1#(lf)#(tab),s.PayHrsPaid2#(lf)#(tab),s.PayRate2#(lf)#(tab),s.PayAmount2#(lf)#(tab),s.PaidMealBreakStatus#(lf)    ,s.MealBreakTime#(lf)#(tab),s.OrderedBy#(lf)#(tab),dbo.FirstUpdateForShift(s.ShiftId)#(tab)#(tab)#(tab)#(tab)AS ShiftCreated#(lf)#(tab),s.ConfirmedDate#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS ShiftConfirmed#(lf)#(tab)--,dbo.TimeConfirmedClient(s.ShiftID)#(tab)#(tab)#(tab)#(tab)AS TimeConfirmedClient#(lf)#(tab)--,dbo.AllocatorConfirmedClient(s.ShiftId)#(tab)#(tab)AS AllocatorConfirmedClient#(lf)#(tab)--,dbo.TimeConfirmedMember(s.ShiftID)#(tab)#(tab)#(tab)#(tab)AS TimeConfirmedMember#(lf)#(tab)--,dbo.AllocatorConfirmedMember(s.ShiftId)#(tab)#(tab)AS AllocatorConfirmedMember#(lf)#(tab)--,dbo.TimeConfirmedMemberAndClient(s.ShiftID)#(tab)AS TimeConfirmedMemberAndClient#(lf)#(tab)--,dbo.AllocatorConfirmedMemberAndClient(s.ShiftId)#(tab)AS AllocatorConfirmedMemberAndClient#(lf)#(tab),dbo.LastUpdateForShift(s.ShiftId)#(tab)#(tab)#(tab)#(tab)AS ShiftLastUpdated#(lf)#(tab),dbo.isEducationShift(s.ShiftID)#(tab)#(tab)#(tab)#(tab)AS [EducationShiftFlag]#(lf)#(tab),o.description#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS [Outcome]#(lf)#(tab),GETDATE()#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS [ExtractDate]#(lf)#(tab),dbo.ShiftSlot(s.StartDate)#(tab)#(tab)#(tab)#(tab)#(tab)#(tab)AS [ShiftStartSlot]#(lf)FROM dbo.Shift s#(lf)LEFT JOIN (#(lf)#(tab)select *#(lf)#(tab)from dbo.decode #(lf)#(tab)where category = 'Outcome'#(lf)) o on s.OutcomeType = o.value#(lf)where s.AgencyID = 4 AND#(lf)#(tab)(s.MemberID <> 1 OR s.MemberID IS NULL) and#(lf)#(tab)s.StartDate >= DATEADD(year,-3,GETDATE())"]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"StartDate", type date}})
				in
				    #"Changed Type"

