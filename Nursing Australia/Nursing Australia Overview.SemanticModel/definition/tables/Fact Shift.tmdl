	measure IncludedShiftDateRangePage = "Filtered date range: " & FORMAT(MIN('Fact Shift'[StartDateTime]), "DD/MM/YYYY hh:mm") & " - " & FORMAT(MAX('Fact Shift'[StartDateTime]), "DD/MM/YYYY hh:mm")
		displayFolder: DateTime
