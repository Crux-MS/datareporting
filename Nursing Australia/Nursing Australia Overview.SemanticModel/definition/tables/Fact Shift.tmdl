		lineageTag: 41ca1131-1083-4201-b033-d86b5d289870

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ShiftsFilledVsPaidHours = [FilledShiftHours] - [Total hours paid]
		displayFolder: KPIs
		lineageTag: 24a0a41f-124e-408e-8347-e8b381fb6b6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure NewShiftHours = CALCULATE([ShiftDurationHoursWorked], 'Fact Shift'[Outcome] = "A-Unfilled", 'Dim Client'[BillableClientFlag] = TRUE())
		displayFolder: KPIs
		lineageTag: 9edde52a-07be-4916-bd49-660d415cd6dd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

