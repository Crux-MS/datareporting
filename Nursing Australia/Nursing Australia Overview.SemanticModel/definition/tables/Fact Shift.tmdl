	measure TotalPeriodTarget = ```
			[TotalDailyTarget] * IF(
			    DATEDIFF(MIN('Dim Shift Start Date'[ShiftStartDate]), MAX('Dim Shift Start Date'[ShiftStartDate]),DAY) = 0, 
			    1, 
			    DATEDIFF(MIN('Dim Shift Start Date'[ShiftStartDate]), MAX('Dim Shift Start Date'[ShiftStartDate]),DAY)
			)
			```
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c7be7290-30f4-4987-889b-a4923bc8482f

	measure TotalDailyTarget = 550
		formatString: 0
		displayFolder: KPIs
		lineageTag: 8ac72565-98aa-45bf-9712-49bf29f4da95

	measure RemainderPeriodTarget = [TotalPeriodTarget] - [FilledShiftHours]
		displayFolder: KPIs
		lineageTag: 7923c894-50be-47cb-8888-fe510bc6e8ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ShiftTargetRemainderIndicatorArrows = ```
			
			VAR _remainderTarget = [RemainderPeriodTarget]
			VAR UpArrow = UNICHAR(9650)
			VAR DownArrow = UNICHAR(9660)
			VAR Result = SWITCH(TRUE, 
			     _remainderTarget = 0, "",
			     _remainderTarget < 0, UpArrow, 
			    DownArrow
			)
			
			RETURN Result  
			```
		displayFolder: KPIs
		lineageTag: ab72eacf-4574-44f5-b840-12e811ee5d62

