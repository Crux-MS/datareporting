table 'Fact Shift'
	lineageTag: dc261a27-91c1-4de0-b35f-9edf5809287a

	measure FullShiftDurationHours = CALCULATE(SUM('Fact Shift'[TotalShiftDurationMins])/60, CROSSFILTER('Dim Shift Allocation'[ShiftID], 'Fact Shift'[ShiftId], Both))
		displayFolder: Duration
		lineageTag: 0b99c30a-7a2e-496e-a9a9-c034a20deecb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure FilledShiftHours = CALCULATE([ShiftDurationHoursWorked], 'Fact Shift'[Outcome] = "D-Confirmed Member and Client", 'Dim Client'[BillableClientFlag] = TRUE())
		formatString: #,0.00
		displayFolder: KPIs
		lineageTag: 573a028e-c9ca-4a35-94e8-eb698263bde0

	measure ShiftCancelledByClientHours = CALCULATE([ShiftDurationHoursWorked], 'Fact Shift'[Outcome] = "F-Cancelled by Client", 'Dim Client'[BillableClientFlag] = TRUE())
		displayFolder: KPIs
		lineageTag: d63b5eb3-a076-42a8-b31b-c5a2d9919624

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UTFShiftStillNeededHours = CALCULATE([ShiftDurationHoursWorked], 'Fact Shift'[Outcome] = "G-Unable to Fill - Still Needed", 'Dim Client'[BillableClientFlag] = TRUE())
		displayFolder: KPIs
		lineageTag: 73551b33-e6d5-4638-8478-dfa2edb03fed

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ControllableOrdersHours = [AvailableOpportunityHours] + [UTFShiftNoLongerRequiredHours]
		displayFolder: KPIs
		lineageTag: 05a9e7b9-6549-4ea0-9e4a-82da8a682437

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Controllable Fill Rate' = DIVIDE([FilledShiftHours], [ControllableOrdersHours])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs
		lineageTag: 39c8fd3b-b9b5-4dfb-97c8-9068fefdc65e

	measure ShiftCancelledByClientRate = DIVIDE([ShiftCancelledByClientHours], [TotalOrdersHours])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs
		lineageTag: 7a34998e-f654-4fb0-9a63-91817c87dd79

	measure TotalOrdersHours = [ShiftCancelledByClientHours] + [ControllableOrdersHours]
		displayFolder: KPIs
		lineageTag: 0dfdd6ca-338e-47da-8cc3-7eaf1911862d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total hours paid' = SUM('Fact Shift'[PayHrsPaid1]) + SUM('Fact Shift'[PayHrsPaid2])
		displayFolder: Pay
		lineageTag: eeac71af-01bd-4a9b-8e78-73c62330686c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UTFShiftNoLongerRequiredHours = CALCULATE([ShiftDurationHoursWorked], 'Fact Shift'[Outcome] = "H-Unable to Fill - No Longer Required", 'Dim Client'[BillableClientFlag] = TRUE())
		displayFolder: KPIs
		lineageTag: bb1027f3-cc2a-46e8-a1b1-aef037e54f15

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AvailableOpportunityFilledRate = DIVIDE(COALESCE([FilledShiftHours], 0), [AvailableOpportunityHours])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs
		lineageTag: f3a607c4-ec0b-4ea5-a056-7de8e8bc12eb

	measure AvailableOpportunityHours = [FilledShiftHours] + [UTFShiftStillNeededHours]
		displayFolder: KPIs
		lineageTag: 433765f6-2925-42d1-abcd-94bb933cf4c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AverageDurationHours = CALCULATE(AVERAGE('Fact Shift'[ShiftWorkedDurationMins])/60, CROSSFILTER('Dim Workforce'[MemberId], 'Fact Shift'[MemberID], Both), 'Dim Client'[BillableClientFlag] = TRUE())
		displayFolder: Duration
		lineageTag: f5c2156c-7ffd-4d50-9c2c-bee0103dc3cc

