				    Source = Sql.Database("10.2.0.5\azhrinkuat,50660", "HRLink", [Query="select mt.[MemberId]#(lf)    ,t.Name      AS [Trade]#(lf)    ,t.SkilledTrade#(lf)    ,[ClassName]#(lf)    ,[AnniversaryDate]#(lf)    ,[TrainingInstitution]#(lf)    ,[CompletionDate]#(lf)    ,[PracCertNbr]#(lf)    ,[PracCertExpiryDate]#(lf)    ,[EnabledStatus]#(lf)FROM [HRLink].[dbo].[MemberTrade] mt#(lf)LEFT JOIN dbo.Trade t ON mt.TradeId = t.TradeId#(lf)WHERE MemberId <> 1"])
				in
				    Source

