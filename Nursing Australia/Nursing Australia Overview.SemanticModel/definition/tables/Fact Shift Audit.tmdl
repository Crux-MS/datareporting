	partition 'Fact Shift Audit' = m
		mode: import
		queryGroup: Shifts
		source =
				let
				    Source = Sql.Database("10.2.0.5\azhrinkuat,50660", "HRLink", [Query="WITH ShiftUnfilled AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 0#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftConfMemNotCli AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 1#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftConfCliNotMem AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 9#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftConfMemAndCli AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 2#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftCancelledbyCli AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 3#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftCancelledbyOp AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 5#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftUTFStillNeeded AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 4#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftUTFNotRequired AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType = 10#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)CombinedFirstShiftAudits AS (#(lf)    SELECT * FROM ShiftUnfilled#(lf)    UNION #(lf)    SELECT * FROM ShiftConfMemNotCli#(lf)    UNION #(lf)    SELECT * FROM ShiftConfCliNotMem#(lf)    UNION #(lf)    SELECT * FROM ShiftConfMemAndCli#(lf)    UNION #(lf)    SELECT * FROM ShiftCancelledbyCli#(lf)    UNION #(lf)    SELECT * FROM ShiftCancelledbyOp#(lf)    UNION #(lf)    SELECT * FROM ShiftUTFStillNeeded#(lf)    UNION #(lf)    SELECT * FROM ShiftUTFNotRequired#(lf)),#(lf)ShiftAuditLog AS(#(lf)    SELECT sa.[ShiftID]#(lf)        ,[ShiftAuditID]#(lf)        ,[MemberID]#(lf)        ,a.Name           AS [Agency]#(lf)        ,[StartDate]#(lf)        ,[FinishDate]#(lf)        ,[LocationID]#(lf)        ,DATEDIFF(MINUTE, StartDate, FinishDate)#(tab)AS [ShiftDurationMins]#(lf)        ,DATEDIFF(MINUTE, StartDate, FinishDate) - MealBreakTime  AS [ShiftWorkedDurationMins]#(lf)        ,o.Description    AS Outcome#(lf)        ,[ConfirmedWith]#(lf)        ,[ConfirmedDate]#(lf)        ,[PayRequestedClassName]#(lf)        ,[PayClassName]#(lf)        ,[InvClassName]#(lf)        ,[OrderedBy]#(lf)        ,[WillPayClassName]#(lf)        ,[PaidMealBreakStatus]#(lf)        ,[MealBreakTime]#(lf)        ,[UserName]       AS Allocator#(lf)        ,[UpdateTime]#(lf)        ,CAST(UpdateTime as date) as UpdateDate#(lf)    FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)    LEFT JOIN (#(lf)#(tab)select *#(lf)#(tab)from dbo.decode #(lf)#(tab)where category = 'Outcome'#(lf)    ) o on sa.OutcomeType = o.value#(lf)    LEFT JOIN dbo.Agency a on sa.AgencyID = a.AgencyID)#(lf)Select sal.[ShiftID]#(lf)        ,[ShiftAuditID]#(lf)        ,[MemberID]#(lf)        ,[Agency]#(lf)        ,[StartDate]#(lf)        ,[FinishDate]#(lf)        ,[LocationID]#(lf)        ,[ShiftDurationMins]#(lf)        ,[ShiftWorkedDurationMins]#(lf)        ,Outcome#(lf)        ,[ConfirmedWith]#(lf)        ,[ConfirmedDate]#(lf)        ,[PayRequestedClassName]#(lf)        ,[PayClassName]#(lf)        ,[InvClassName]#(lf)        ,[OrderedBy]#(lf)        ,[WillPayClassName]#(lf)        ,[PaidMealBreakStatus]#(lf)        ,[MealBreakTime]#(lf)        ,Allocator#(lf)        ,[UpdateTime]#(lf)        ,CAST(UpdateTime as date) as UpdateDate#(lf)FROM CombinedFirstShiftAudits cfsa#(lf)LEFT JOIN ShiftAuditLog sal on sal.ShiftID = cfsa.ShiftID and sal.ShiftAuditID = cfsa.FirstShiftAuditID"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

