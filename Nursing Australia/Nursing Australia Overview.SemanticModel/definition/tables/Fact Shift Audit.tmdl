		lineageTag: 303e1c9e-40e3-4c79-9332-0544eeeff5d9

	measure ShiftsUpdatedByAllocatorHeader =
			VAR _allocatorCount = DISTINCTCOUNT('Fact Shift Audit'[Allocator])
			VAR _maxAllocators = CALCULATE(DISTINCTCOUNT('Fact Shift Audit'[Allocator]), ALL('Fact Shift Audit'))
			VAR _logic = "Shift updates by " & IF(_allocatorCount = 1, SELECTEDVALUE('Fact Shift Audit'[Allocator]), "all allocators")
			RETURN _logic
		lineageTag: 03aa6840-97a5-4107-b11e-256f8cbcfddd

