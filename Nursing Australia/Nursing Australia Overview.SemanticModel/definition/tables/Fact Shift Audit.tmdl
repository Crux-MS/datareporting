		displayFolder: Duration
		lineageTag: 0c786296-9821-43dc-ae06-d9d8cc00849d

	measure CancelledByClientShiftAuditFillRate = DIVIDE([CancelledByClientShiftAuditHours], [TotalOrdersShiftAuditHours])
