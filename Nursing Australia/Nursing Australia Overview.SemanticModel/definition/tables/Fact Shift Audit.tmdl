	measure ControllableOrdersShiftAuditHours = [AvailableOpportunityAuditHours] + [UTFShiftAuditNotNeededHours]
		displayFolder: Duration
		lineageTag: bc7fc74f-2a94-4fba-a89f-5b88a51d1425

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ControllableOrdersAuditFillRate = DIVIDE([FilledShiftAuditHours], [ControllableOrdersShiftAuditHours])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs
		lineageTag: 4d3b085d-d484-40c3-a7e4-4928429329d2

	measure TotalOrdersShiftAuditHours = [ControllableOrdersHours] + [CancelledByClientShiftAuditHours]
