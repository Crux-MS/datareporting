table 'Fact Shift Audit'
	lineageTag: 49e479a3-2840-4af5-993d-9d59862dfdce

	measure FilledShiftAuditHours = CALCULATE([ShiftAuditWorkedDurationHours], 'Fact Shift Audit'[Outcome] = "D-Confirmed Member and Client")
		formatString: #,0.00
		displayFolder: Duration
		lineageTag: f4352e84-0750-4a1a-8417-8176578c3a1b

	measure ShiftAuditWorkedDurationHours = CALCULATE(SUM('Fact Shift Audit'[ShiftWorkedDurationMins])/60)
		displayFolder: Duration
		lineageTag: e085fd70-87e8-4ccd-88cf-f2a1b62534f1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UTFShiftAuditStillNeededHours = CALCULATE([ShiftAuditWorkedDurationHours], 'Fact Shift'[Outcome] = "G-Unable to Fill - Still Needed", 'Dim Client'[BillableClientFlag] = TRUE())
		displayFolder: Duration
		lineageTag: 627c08d3-1248-4c89-ac0b-cd05739a0d93

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AvailableOpportunityAuditHours = [FilledShiftAuditHours] + [UTFShiftAuditStillNeededHours]
		formatString: #,0.0
		displayFolder: Duration
		lineageTag: 5aa4e60b-6751-4df1-8bac-8a514d36f7ad

	measure AvailableOpportunityAuditFilledRate = DIVIDE(COALESCE([FilledShiftAuditHours], 0), [AvailableOpportunityAuditHours])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs
		lineageTag: 663068c3-064c-40dc-801c-cd308322f9e4

	measure CountShiftAudit = DISTINCTCOUNT('Fact Shift Audit'[ShiftAuditID])
