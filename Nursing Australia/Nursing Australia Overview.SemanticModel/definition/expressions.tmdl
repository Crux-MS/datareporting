expression 'Fact Shift Audit old' =
		let
		    Source = Sql.Database("10.2.0.5\azhrinkuat,50660", "HRLink", [Query="WITH FirstShiftAudits AS(#(lf)    Select ShiftId#(lf)        ,OutcomeType#(lf)        ,MIN(ShiftAuditID)  AS FirstShiftAuditID#(lf)    FROM [HRLink].[dbo].[ShiftAudit] #(lf)    Where StartDate >= DATEADD(year,-3,GETDATE()) and AgencyID = 4 and OutcomeType in (1, 2, 3, 4, 9, 10)#(lf)    GROUP By ShiftID, OutcomeType#(lf)),#(lf)ShiftAuditLog AS(#(lf)    SELECT [ShiftID]#(lf)          ,[ShiftAuditID]#(lf)          ,[MemberID]#(lf)          ,a.Name           AS [Agency]#(lf)          ,[StartDate]#(lf)          ,[FinishDate]#(lf)          ,[LocationID]#(lf)          ,DATEDIFF(MINUTE, StartDate, FinishDate)#(tab)AS [ShiftDurationMins]#(lf)          ,DATEDIFF(MINUTE, StartDate, FinishDate) - MealBreakTime  AS [ShiftWorkedDurationMins]#(lf)          ,o.Description    AS Outcome#(lf)          ,[ConfirmedWith]#(lf)          ,[ConfirmedDate]#(lf)          ,[PayRequestedClassName]#(lf)          ,[PayClassName]#(lf)          ,[InvClassName]#(lf)          ,[OrderedBy]#(lf)          ,[WillPayClassName]#(lf)          ,[PaidMealBreakStatus]#(lf)          ,[MealBreakTime]#(lf)          ,[UserName]       AS Allocator#(lf)          ,[UpdateTime]#(lf)          ,CAST(UpdateTime as date) as UpdateDate#(lf)      FROM [HRLink].[dbo].[ShiftAudit] sa#(lf)      LEFT JOIN (#(lf)#(tab)    select *#(lf)#(tab)    from dbo.decode #(lf)#(tab)    where category = 'Outcome'#(lf)    ) o on sa.OutcomeType = o.value#(lf)    LEFT JOIN dbo.Agency a on sa.AgencyID = a.AgencyID#(lf)      Where StartDate >= DATEADD(year,-3,GETDATE()) and sa.AgencyID = 4 and OutcomeType in (1, 2, 3, 4, 9, 10)#(lf)  )#(lf)Select sal.[ShiftID]#(lf)        ,[ShiftAuditID]#(lf)        ,[MemberID]#(lf)        ,[Agency]#(lf)        ,[StartDate]#(lf)        ,[FinishDate]#(lf)        ,[LocationID]#(lf)        ,[ShiftDurationMins]#(lf)        ,[ShiftWorkedDurationMins]#(lf)        ,Outcome#(lf)        ,[ConfirmedWith]#(lf)        ,[ConfirmedDate]#(lf)        ,[PayRequestedClassName]#(lf)        ,[PayClassName]#(lf)        ,[InvClassName]#(lf)        ,[OrderedBy]#(lf)        ,[WillPayClassName]#(lf)        ,[PaidMealBreakStatus]#(lf)        ,[MealBreakTime]#(lf)        ,Allocator#(lf)        ,[UpdateTime]#(lf)        ,CAST(UpdateTime as date) as UpdateDate#(lf)FROM FirstShiftAudits fsa#(lf)LEFT JOIN ShiftAuditLog sal on sal.ShiftID = fsa.ShiftID and sal.ShiftAuditID = fsa.FirstShiftAuditID#(lf)where sal.ShiftID = 9787243"])
		in
		    Source
	lineageTag: 960a319b-9a33-49c8-8c11-ffd828e244b5
