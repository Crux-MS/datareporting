expression 'Calendar - Source' =
		let
		    Source = List.Dates(Date.From(#"L2Y Date"), 4400, #duration(1, 0, 0, 0)),
		    #"Converted to Table" = Table.FromList(Source, Splitter.SplitByNothing(), null, null, ExtraValues.Error),
		    #"Changed Type with Locale" = Table.TransformColumnTypes(#"Converted to Table", {{"Column1", type date}}, "en-AU"),
		    #"Renamed Columns" = Table.RenameColumns(#"Changed Type with Locale",{{"Column1", "Date"}}),
		    #"Inserted Year" = Table.AddColumn(#"Renamed Columns", "Year", each Date.Year([Date]), Int64.Type),
		    #"Inserted Month Name" = Table.AddColumn(#"Inserted Year", "MonthName", each Date.MonthName([Date]), type text),
		    #"Inserted MMM YYYY" = Table.AddColumn(#"Inserted Month Name", "MMM YYYY", each Text.Combine({Date.ToText([Date], "MMM"), " ", Date.ToText([Date], "yyyy")}), type text),
		    #"Inserted Month Number" = Table.AddColumn(#"Inserted MMM YYYY", "MonthNumber", each Date.Month([Date]), Int64.Type),
		    #"Inserted YYYYMM" = Table.AddColumn(#"Inserted Month Number", "YYYYMM", each if [MonthNumber] <=9 then Text.From([Year]) & "0" & Text.From([MonthNumber]) else Text.From([Year]) & Text.From([MonthNumber])),
		    #"Inserted Day Number" = Table.AddColumn(#"Inserted YYYYMM", "DayNumber", each Date.Day([Date]), Int64.Type),
		    #"Inserted Day Name" = Table.AddColumn(#"Inserted Day Number", "DayName", each Date.DayOfWeekName([Date]), type text),
		    #"Inserted Day of Week" = Table.AddColumn(#"Inserted Day Name", "DayOfWeek", each Date.DayOfWeek([Date]), Int64.Type),
		    #"Inserted Start of Week" = Table.AddColumn(#"Inserted Day of Week", "Start of Week", each Date.StartOfWeek([Date]), type date),
		    #"Inserted Start of Year" = Table.AddColumn(#"Inserted Start of Week", "StartOfYear", each Date.StartOfYear([Date]), type date),
		    #"Inserted Week of Year" = Table.AddColumn(#"Inserted Start of Year", "WeekOfYear", each Date.WeekOfYear([Date]), Int64.Type),
		    #"Added Rolling Date Difference" = Table.AddColumn(#"Inserted Week of Year", "RollingDateDifference", each Duration.Days([Date] - Date.From(DateTime.LocalNow()))),
		    #"Added Slicer MMM YYYY" = Table.AddColumn(#"Added Rolling Date Difference", "Slicer MMM YYYY", each let
		    currentMonthYear = List.First(
		        Table.SelectRows(#"Added Rolling Date Difference", each [RollingDateDifference] = 0)[MMM YYYY]
		    )
		in
		    if [MMM YYYY] = currentMonthYear then "Current Month" else [MMM YYYY]),
		    #"Added d MMM" = Table.AddColumn(#"Added Slicer MMM YYYY", "d MMM", each Date.ToText([Date], "d MMM")),
		    #"Added MMdd" = Table.AddColumn(#"Added d MMM", "MMdd", each Date.ToText([Date], "MMdd")),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Added MMdd",{{"YYYYMM", Int64.Type}, {"RollingDateDifference", Int64.Type}, {"Slicer MMM YYYY", type text}, {"d MMM", type text}, {"MMdd", Int64.Type}})
		in
		    #"Changed Type1"
