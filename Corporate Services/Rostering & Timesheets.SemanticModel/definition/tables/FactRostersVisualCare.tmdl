	partition FactRostersVisualCare = m
		mode: import
		queryGroup: Rosters
		source =
				let
				    Source = #"Rosters - Source",
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Notes"}),
				    #"Added TimesheetStartCompletedFlag" = Table.AddColumn(#"Removed Columns", "TimesheetStartCompletedFlag", each if [APP_StartTime] <> null then 1 else 0),
				    #"Added TimesheetFinishCompletedFlag" = Table.AddColumn(#"Added TimesheetStartCompletedFlag", "TimesheetFinishCompletedFlag", each if [APP_FinishTime] <> null then 1 else 0),
				    #"Added TimesheetAllTimesCompletedFlag" = Table.AddColumn(#"Added TimesheetFinishCompletedFlag", "TimesheetAllTimesCompletedFlag", each if [APP_StartTime] <> null and [APP_FinishTime] <> null then 1 else 0),
				    #"Added TimesheetAnyTimesCompletedFlag" = Table.AddColumn(#"Added TimesheetAllTimesCompletedFlag", "TimesheetAnyTimesCompletedFlag", each if [APP_StartTime] <> null or [APP_FinishTime] <> null then 1 else 0),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added TimesheetAnyTimesCompletedFlag",{{"TimesheetStartCompletedFlag", Int64.Type}, {"TimesheetFinishCompletedFlag", Int64.Type}, {"TimesheetAllTimesCompletedFlag", Int64.Type}, {"TimesheetAnyTimesCompletedFlag", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

