	measure BillableUnits =
			SUMX(
			    VALUES(DimRosterServicesVisualCare[ServiceCode]),
			    VAR _serviceCode = DimRosterServicesVisualCare[ServiceCode]
			    VAR _multiplier = CALCULATE(MAX(DimRosterServicesVisualCare[BillableUnitsMultiplier]))
			    VAR _rosteredHours = [RosteredHours]
			    VAR _logic = IF(_serviceCode = "CS-G-Sleepover",
			        [CountRosteredShifts],
			        _rosteredHours *  _multiplier)
			    RETURN _logic
			)
		formatString: #,0.0
		lineageTag: 9439fd45-34eb-47b4-8dc7-f63b0ab208f6

