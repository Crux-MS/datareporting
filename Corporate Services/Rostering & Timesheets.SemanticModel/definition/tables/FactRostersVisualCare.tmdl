		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AvgVsRosteredHoursWeeklyDifference = [WorkerHoursPaid] - [AverageRosteredHoursAllTime]
		lineageTag: fd399364-09dc-47b9-9134-1ed413b91288

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MinVariationFromAvgHours = ```
			
			    MINX(
			        ALLSELECTED(DimRosterDateOfService[Start of Week]),
			        [AvgVsRosteredHoursWeeklyDifference]
			    )
