	measure CurrentRecurringShiftHours =
			VAR _selectedDate = SELECTEDVALUE(DimRosterDateOfService[Start of Week])
			VAR _currentDate = MAX(DimRosterDateOfService[Date])
			VAR _recurrenceStartDate = SELECTEDVALUE(FactRostersVisualCare[RecurrenceStart])
			VAR _logic = CALCULATE(
			    [RosteredHours],
			    OR(FactRostersVisualCare[RecurrenceEnd] >= _currentDate, FactRostersVisualCare[RecurrenceEnd] = BLANK()),
			    FILTER(
			        ALL(DimRosterRecurrenceStartDate[Date]),
			        DimRosterRecurrenceStartDate[Date] <= _currentDate)
			    )
			RETURN _logic
		displayFolder: Duration
		lineageTag: 086bbb5b-5e72-4a08-9b02-317a81ece122

		annotation PBI_FormatHint = {"isGeneralNumber":true}

