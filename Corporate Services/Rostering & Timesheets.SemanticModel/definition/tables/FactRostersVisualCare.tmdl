	measure UnfilledShiftHours = ```
			CALCULATE([RosteredHours], 
			    DimWorkforceVisualCare[FirstName] = "*UNDELIVERED",  
			    DimWorkforceVisualCare[FirstName] = "_TBA" || 
			    DimWorkforceVisualCare[FirstName] = "_TBA Base"
			)
			```
		displayFolder: Duration
		lineageTag: 8510763a-6479-4997-8b71-65b2a9b9e982

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure UnallocatedHours% =
			VAR _dateSelected = ISINSCOPE(DimRosterDateOfService[Date])
			VAR _locationCodeSelcted = ISINSCOPE(DimRosterLocationsVisualCare[Code])
			VAR _selectedArea = SELECTEDVALUE(DimRosterLocationsVisualCare[Area])
			VAR _numerator = [RosteredHours]
			VAR _denominator = SWITCH(
			    TRUE(),
			    _dateSelected, CALCULATE([RosteredHours], ALLSELECTED(DimRosterDateOfService[Date])),
			    _locationCodeSelcted, CALCULATE([RosteredHours], ALL(DimWorkforceVisualCare[FullName]), DimRosterLocationsVisualCare[Area] = _selectedArea),
			    CALCULATE([RosteredHours], ALLSELECTED(DimRosterDateOfService[Date]), ALL(DimWorkforceVisualCare[FullName])))
			VAR _logic = DIVIDE(_numerator, _denominator)
			RETURN _logic
		displayFolder: Percentages
		lineageTag: 0c2bcdf4-eb37-4501-8e11-a10d7085a63b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

