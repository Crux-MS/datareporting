	measure AverageRosteredHoursAllTime =
			IF(
			    AVERAGEX(
			        CROSSJOIN(
			            ALL(DimRosterDateOfService[Start of Week]),
			            ALL(FactRostersVisualCare[CarerId])
			        ),
			        [RosteredHours]
			    ) = BLANK(),
			    0,
			    AVERAGEX(
			        CROSSJOIN(
			            ALL(DimRosterDateOfService[Start of Week]),
			            ALL(FactRostersVisualCare[CarerId])
			        ),
			        [RosteredHours]
			    )
			)
		displayFolder: Duration
		lineageTag: eebf174b-b586-4c33-b82e-40e248f69448

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AverageRosteredHours = AVERAGE(FactRostersVisualCare[Minutes])/60
		displayFolder: Duration
		lineageTag: e4166e4e-3456-4b77-bd79-ed2f91a01169

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DisplayRosteredHours = COALESCE([RosteredHours], 0)
