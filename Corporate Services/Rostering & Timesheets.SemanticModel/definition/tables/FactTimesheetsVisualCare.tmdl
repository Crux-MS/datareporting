	column SelfCompletedTimesheetFlag
		dataType: int64
		formatString: 0
		displayFolder: Flags
		lineageTag: 788c92d5-a974-4a4f-822d-26778cf6e1e8
		summarizeBy: count
		sourceColumn: SelfCompletedTimesheetFlag

		annotation SummarizationSetBy = User

	partition FactTimesheetsVisualCare = m
		mode: import
		queryGroup: Timesheets
		source = ```
				let
				    Source = #"Timesheets - Source",
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Notes"}),
				    #"Added Custom" = Table.AddColumn(#"Removed Columns", "SelfCompletedTimesheetFlag", each let 
				createdby = [CreatedBy],
				carerid = [CarerId],
				tryConvert = try Number.FromText(Text.Trim(createdby)) otherwise null 
				in 
				if tryConvert = null then 0
				else if tryConvert = carerid then 1
				else 0),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom",{{"SelfCompletedTimesheetFlag", Int64.Type}})
				in
				    #"Changed Type"
				```

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

