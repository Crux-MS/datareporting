table FactTimesheetsVisualCare
	lineageTag: 294a95dc-b6c5-48bc-b178-54e73f69270a

	measure CountTimesheets = CALCULATE(COUNT('FactTimesheetsVisualCare'[TimeSheetId]), USERELATIONSHIP('FactRostersVisualCare'[TimeSheetId], 'FactTimesheetsVisualCare'[TimeSheetId]), CROSSFILTER('FactRostersVisualCare'[TimeSheetId], 'FactTimesheetsVisualCare'[TimeSheetId], Both))
		formatString: 0
		displayFolder: Timesheets
		lineageTag: cc3ad3dd-84dc-4d4e-afa4-721789b566da

	measure CountTimesheetVariationApproved = CALCULATE([CountTimesheetVariationRequested], 'FactTimesheetsVisualCare'[VariationApproved] = TRUE())
		formatString: 0
		displayFolder: Variation
		lineageTag: 8efe4c4c-3db5-4626-985d-574d737ad703

	measure CountTimesheetVariationRejected = CALCULATE([CountTimesheetVariationRequested], 'FactTimesheetsVisualCare'[VariationApproved] = FALSE())
		formatString: 0
		displayFolder: Variation
		lineageTag: b7609e0e-54d2-4430-8286-a0a67ca620c6

	measure CountTimesheetVariationRequested = CALCULATE([CountTimesheets], 'FactTimesheetsVisualCare'[Variation] = TRUE())
		formatString: 0
		displayFolder: Variation
		lineageTag: e4ffcd24-7248-4c0b-8211-cea596864fc1

	measure CreatedByUserFullName =
			VAR _carerId = CALCULATE(FORMAT(SELECTEDVALUE('FactTimesheetsVisualCare'[CarerId]), "General Number"), CROSSFILTER('FactRostersVisualCare'[TimeSheetId], 'FactTimesheetsVisualCare'[TimeSheetId], Both))
			VAR _workerFullName = CALCULATE(SELECTEDVALUE(DimWorkforceVisualCare[FullName]), CROSSFILTER('FactRostersVisualCare'[TimeSheetId], 'FactTimesheetsVisualCare'[TimeSheetId], Both), CROSSFILTER('FactRostersVisualCare'[CarerId], DimWorkforceVisualCare[CarerId], Both))
			VAR _createdBy = CALCULATE(SELECTEDVALUE('FactTimesheetsVisualCare'[CreatedBy]), CROSSFILTER('FactRostersVisualCare'[TimeSheetId], 'FactTimesheetsVisualCare'[TimeSheetId], Both))
			VAR _createdByFullName = CALCULATE(SELECTEDVALUE('DimTimesheetCreatedByUserVisualCare'[Full Name]), CROSSFILTER('FactRostersVisualCare'[TimeSheetId], 'FactTimesheetsVisualCare'[TimeSheetId], Both), CROSSFILTER('FactTimesheetsVisualCare'[CreatedBy], 'DimTimesheetCreatedByUserVisualCare'[Username], Both))
			VAR _logic = IF(_carerId = _createdBy, _workerFullName, _createdByFullName)
			RETURN _logic
		displayFolder: Metadata
		lineageTag: c41ac6fc-7349-47bf-8097-bd818b4a660d

	measure TimesheetHours = CALCULATE(SUM(FactTimesheetsVisualCare[Minutes])/60, USERELATIONSHIP(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId]), CROSSFILTER(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId], Both))
		formatString: #,0.0
		displayFolder: Date/Time
		lineageTag: 14011d5e-756b-4f9f-af9d-cd599cbcee9a

	measure LatestTimesheetCreatedBy = ```
			VAR _latestCreatedDate = [LatestTimesheetCreated]
			VAR _logic = CALCULATE(
			    [CreatedByUserFullName], 
			    FILTER(FactTimesheetsVisualCare,
			        FactTimesheetsVisualCare[CreatedTime] = _latestCreatedDate),
			    CROSSFILTER(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId], Both), 
			    CROSSFILTER('DimTimesheetCreatedByUserVisualCare'[Username], FactTimesheetsVisualCare[CreatedBy],Both)
			)
			RETURN _logic
			```
		lineageTag: 1de66df4-03f5-4200-8dfe-1ee8cefd39bd

	measure LatestTimesheetCreated = CALCULATE(MAX(FactTimesheetsVisualCare[CreatedTime]), USERELATIONSHIP(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId]), CROSSFILTER(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId], Both))
		formatString: Short Date
		lineageTag: b90292ae-3186-4e98-8b59-b13ebe9463fe

	measure LatestTimesheetAge = DATEDIFF([LatestTimesheetCreated], TODAY(), DAY)
		formatString: 0
		lineageTag: 9d91cfa3-b10d-4004-91d0-7fc1b9448562

	measure SelectedTimesheetsPeriod = FORMAT(MIN(FactTimesheetsVisualCare[DateOfService]), "dd MMM YYYY") & " - " & FORMAT(MAX(FactTimesheetsVisualCare[DateOfService]), "dd MMM yyyy")
		lineageTag: 1a5c3416-8f14-45ae-a1e6-754cd9439f09

	measure TimesheetAppFinish = CALCULATE(SELECTEDVALUE(FactTimesheetsVisualCare[APP_FinishTime]), USERELATIONSHIP(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId]), CROSSFILTER(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId], Both))
		formatString: General Date
		displayFolder: App
		lineageTag: 57285af3-9481-4393-800e-b25ca8ca53bb

	measure TimesheetAppStart = CALCULATE(SELECTEDVALUE(FactTimesheetsVisualCare[APP_StartTime]), USERELATIONSHIP(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId]), CROSSFILTER(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId], Both))
		formatString: General Date
		displayFolder: App
		lineageTag: 69e233a4-8051-47bd-b40b-9154c79b71d9

	measure VariationHours = CALCULATE(SUM(FactTimesheetsVisualCare[VariationQty])/60, USERELATIONSHIP(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId]), CROSSFILTER(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId], Both), FactTimesheetsVisualCare[VariationQty] >0)
		formatString: 0.00
		displayFolder: Variation
		lineageTag: cc2fe12a-b0f5-4635-8a96-430c78a5a739

	measure 'Self Completed Timesheets %' = ```
			CALCULATE(
			    DIVIDE(
			        SUM(FactTimesheetsVisualCare[SelfCompletedTimesheetFlag]), [CountTimesheets]
			    ), 
			    CROSSFILTER(FactRostersVisualCare[TimeSheetId], FactTimesheetsVisualCare[TimeSheetId], Both)
			)
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c4d2a619-655e-4a92-a2a9-adaaab5ea0e5

