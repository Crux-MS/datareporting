	column 'Day Of Week'
		dataType: int64
		formatString: 0
		lineageTag: 128a57c2-86e8-4d1d-a046-11dc0fc863dd
		summarizeBy: sum
		sourceColumn: Day Of Week

		annotation SummarizationSetBy = Automatic

	/// Definition: Week number within the calendar year.
