		formatString: 0
		lineageTag: 108087a0-db56-4c97-b9e2-629fad0da032
		summarizeBy: sum
		sourceColumn: Year

		annotation SummarizationSetBy = Automatic

	/// Definition: Calendar quarter, 1 to 4.
	/// For analysis: Do not sum.
	column Quarter
		dataType: int64
		formatString: 0
		lineageTag: 398db649-95df-41d4-95cb-ceae07c73d24
		summarizeBy: sum
		sourceColumn: Quarter

		annotation SummarizationSetBy = Automatic

	/// Definition: Month number, 1 to 12.
