/// Definition: Calendar for employment and onboarding event dates. One row per date; a copy of DimShiftDate.
/// For analysis: Date table for employee and new starter measures. Active joins: DimEmployee Start Date, DimWorker account creation date.
table DimEmployeeTenureDate
	lineageTag: 66f689c1-8844-4704-9af3-56723be26a68
	dataCategory: Time

	/// Definition: Date key in YYYYMMDD form.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Date'
		dataType: int64
		formatString: 0
		lineageTag: 41b59728-d9c2-4f7c-9711-183b7c2d4e8a
		summarizeBy: sum
		sourceColumn: Id Date

		annotation SummarizationSetBy = Automatic

	/// Definition: Calendar date.
	/// For analysis: Key: one row per date.
	column Date
		dataType: dateTime
		isKey
		formatString: d/m/yyyy
		lineageTag: 7fdf51c8-caea-4443-a133-91dfd75a4e94
		summarizeBy: none
		sourceColumn: Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	/// Definition: Calendar year.
	/// For analysis: Do not sum.
	column Year
