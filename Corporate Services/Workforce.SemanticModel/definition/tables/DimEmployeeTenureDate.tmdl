		formatString: 0
		lineageTag: db246fb3-f866-4412-a2e7-0ee51fec9ac8
		summarizeBy: sum
		sourceColumn: Day

		annotation SummarizationSetBy = Automatic

	/// Definition: Name of the weekday.
	column 'Day Name'
		dataType: string
		lineageTag: 35e6f738-019b-4897-8dec-06379d9499ac
		summarizeBy: none
		sourceColumn: Day Name

		annotation SummarizationSetBy = Automatic

	/// Definition: Weekday number, 1 (Sunday) to 7 (Saturday).
