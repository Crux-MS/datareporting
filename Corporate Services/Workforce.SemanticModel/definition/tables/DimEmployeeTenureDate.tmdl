		formatString: 0
		lineageTag: e53f9e38-4488-4b69-b522-ed9b242e1183
		summarizeBy: sum
		sourceColumn: Month

		annotation SummarizationSetBy = Automatic

	/// Definition: Month name.
	column 'Month Name'
