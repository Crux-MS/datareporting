/// Definition: Rostered shifts for workers from the roster table in L4_Analytical, including deleted lines. One row per roster line.
/// For analysis: Event history by date of service; group by DimShiftDate and DimWorker.
table FactWorkerRoster
	lineageTag: aecfc80b-3f58-4285-b8e8-5444a158d4ca

	/// Definition: Roster line identifier.
	/// For analysis: Identifier only. Do not sum; count rows for shift numbers.
	column 'Id Roster'
		dataType: int64
		formatString: 0
		lineageTag: bdcab295-8177-40a7-934e-0f82870cf900
		summarizeBy: sum
		sourceColumn: Id Roster

		annotation SummarizationSetBy = Automatic

	/// Definition: Client the shift was for.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Client'
		dataType: int64
		formatString: 0
		lineageTag: d48180be-51bf-4c31-90b4-60e694dffa92
		summarizeBy: sum
		sourceColumn: Id Client

		annotation SummarizationSetBy = Automatic

	/// Definition: Worker who was rostered.
	/// For analysis: Key: joins DimWorker Id Worker (both directions).
	column 'Id Worker'
		dataType: int64
		formatString: 0
		lineageTag: 6ae1f2f1-8658-401e-9404-28910602a0ba
		summarizeBy: none
		sourceColumn: Id Worker

		annotation SummarizationSetBy = Automatic

	/// Definition: Location where the shift took place.
	/// For analysis: No location table in this model. Identifier only. Do not sum.
	column 'Id Location'
		dataType: int64
		formatString: 0
		lineageTag: 8f27e755-7c9b-4a20-92ab-90ab8d553ab9
		summarizeBy: sum
		sourceColumn: Id Location

		annotation SummarizationSetBy = Automatic

	/// Definition: Service type identifier for the shift.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Service'
		dataType: int64
		formatString: 0
		lineageTag: cc0aa0cd-7402-4df4-9893-266d25a4b91c
		summarizeBy: sum
		sourceColumn: Id Service

		annotation SummarizationSetBy = Automatic

	/// Definition: Roster category identifier.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Roster Category'
		dataType: int64
		formatString: 0
		lineageTag: 00618f16-40f3-4db4-8dd0-efc9d5265e77
		summarizeBy: sum
		sourceColumn: Id Roster Category

		annotation SummarizationSetBy = Automatic

	/// Definition: Client service agreement the shift is billed against.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Agreement'
		dataType: int64
		formatString: 0
		lineageTag: 0a797ce5-2f70-47b3-9843-5e9a99f77d41
		summarizeBy: sum
		sourceColumn: Id Agreement

		annotation SummarizationSetBy = Automatic

	/// Definition: Line of the client service agreement the shift is billed against.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Agreement Item'
		dataType: int64
		formatString: 0
		lineageTag: 0bf9860c-9a89-4187-9af2-51b507b8485e
		summarizeBy: sum
		sourceColumn: Id Agreement Item

		annotation SummarizationSetBy = Automatic

	/// Definition: Recurring roster template the shift was created from.
	/// For analysis: Identifier only. Do not sum.
	column 'Id Roster Master'
		dataType: int64
		formatString: 0
		lineageTag: 6eda959f-4d9b-4955-8d39-5700254cef7f
		summarizeBy: sum
		sourceColumn: Id Roster Master

		annotation SummarizationSetBy = Automatic

	/// Definition: Timesheet identifier; -1 when no timesheet exists.
	/// For analysis: Identifier only. Do not sum; exclude -1 for completed shifts.
	column 'Id Timesheet'
		dataType: int64
		formatString: 0
		lineageTag: 6f6f45b6-0ccd-4c81-885b-f96673d6c1d7
		summarizeBy: sum
		sourceColumn: Id Timesheet

		annotation SummarizationSetBy = Automatic

	/// Definition: 1 when a timesheet was submitted for the shift, otherwise 0.
	/// For analysis: Summing counts shifts with a timesheet.
	column 'Has Timesheet'
		dataType: int64
		formatString: 0
		lineageTag: c6aff4dd-4dd5-4f22-ba9f-bd7daccc1a0b
		summarizeBy: sum
		sourceColumn: Has Timesheet

		annotation SummarizationSetBy = Automatic

	/// Definition: Date the shift was delivered.
	/// For analysis: Key: joins DimShiftDate Date.
	column 'Date Of Service'
		dataType: dateTime
		formatString: Long Date
		lineageTag: 8510db5c-eed3-4068-9ddc-c608be627369
		summarizeBy: none
		sourceColumn: Date Of Service

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Definition: Date and time the shift was rostered to start.
	column 'Start Datetime'
		dataType: dateTime
		formatString: General Date
		lineageTag: 493a9112-27d9-4926-b6b3-604f14215fe3
		summarizeBy: none
		sourceColumn: Start Datetime

		variation Variation
			isDefault
			relationship: 31100b7c-9bfd-408b-9bd2-f1635fd198c5
			defaultHierarchy: LocalDateTable_5f3e0afa-e349-4e42-bea3-f9d60a733f51.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	/// Definition: Date and time the shift was rostered to end.
	column 'End Datetime'
		dataType: dateTime
		formatString: General Date
		lineageTag: ab940d39-e764-410e-a0bb-21f5fc92471c
		summarizeBy: none
		sourceColumn: End Datetime

		variation Variation
			isDefault
			relationship: 62ce8fe0-8ac4-4303-9341-427b7b902108
			defaultHierarchy: LocalDateTable_918cf078-b477-4943-a649-16f377e356da.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	/// Definition: Length of the rostered shift in minutes, including breaks.
	/// For analysis: Use Duration Hours for hours.
	column 'Duration Minutes'
		dataType: int64
		formatString: 0
		lineageTag: 96b1b300-7779-45d1-a608-e7e91231acf7
		summarizeBy: sum
		sourceColumn: Duration Minutes

		annotation SummarizationSetBy = Automatic

	/// Definition: Length of the rostered shift in decimal hours, including breaks.
	/// For analysis: Sum for shift hours; exclude deleted lines.
	column 'Duration Hours'
		dataType: double
		lineageTag: dcf28d99-5862-4183-8d50-4a673a0ae5be
		summarizeBy: sum
		sourceColumn: Duration Hours

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Definition: Start time recorded in the worker app, as text.
	column 'App Start Time'
		dataType: string
		lineageTag: 4cf8f232-d08f-444b-a091-66d4da587430
		summarizeBy: none
		sourceColumn: App Start Time

		annotation SummarizationSetBy = Automatic

	/// Definition: End time recorded in the worker app, as text.
	column 'App End Time'
		dataType: string
		lineageTag: 894c041b-0f05-491e-b1af-15603fd60a75
		summarizeBy: none
		sourceColumn: App End Time

		annotation SummarizationSetBy = Automatic

	/// Definition: True when the roster line was deleted in the rostering system.
	/// For analysis: Exclude deleted lines from shift counts and hours.
	column 'Is Deleted'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: b4fa6e4d-2a31-498d-a6c9-d2a765823cc0
		summarizeBy: none
		sourceColumn: Is Deleted

		annotation SummarizationSetBy = Automatic

	/// Definition: True when the shift includes a break.
	column 'Has Break'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 90c1ea9a-9e8c-4490-88f5-1b133090390d
		summarizeBy: none
		sourceColumn: Has Break

		annotation SummarizationSetBy = Automatic

	/// Definition: Time the break starts, as text.
	column 'Break Start Time'
		dataType: string
		lineageTag: 8857813c-fb4c-46b2-971f-e9302fad26ff
		summarizeBy: none
		sourceColumn: Break Start Time

		annotation SummarizationSetBy = Automatic

	/// Definition: Length of the break in minutes.
	column 'Break Minutes'
		dataType: int64
		formatString: 0
		lineageTag: a5d9ced1-08a9-4202-b89b-7d9280658e0a
		summarizeBy: sum
		sourceColumn: Break Minutes

		annotation SummarizationSetBy = Automatic

	/// Definition: Length of the break in decimal hours.
	column 'Break Hours'
		dataType: double
		lineageTag: 3d41ad92-5bad-4cfd-b86c-fbbb8770bc90
		summarizeBy: sum
		sourceColumn: Break Hours

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

