		dataType: dateTime
		formatString: Long Date
		lineageTag: 19ae2386-0fc9-41dd-82da-5150e9fd3fc8
		summarizeBy: none
		sourceColumn: Quarter Start Date

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	partition DimShiftDate = m
		mode: import
		queryGroup: EDP
		source =
				let
				    Source = Sql.Database(ServerName, DatabaseName),
				    Dim_date = fnCleanColumnNames(Source{[Schema="Dim",Item="date"]}[Data]),
				    #"Added MMM YYYY" = Table.AddColumn(Dim_date, "MMM YYYY", each Text.Combine({Date.ToText([Date], "MMM"), " ", Date.ToText([Date], "yyyy")}), type text)
				in
				    #"Added MMM YYYY"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

