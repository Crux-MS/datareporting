	/// Definition: Number of data quality issues on the employee record, 0 to 5: missing division, job title, employment type or start date, and a termination date that does not match the employment status. The probation end date is not counted.
	/// For analysis: 0 means no issues; filter on values above 0 to find records to fix.
	column DataQualityCheck = ```
			VAR _division = IF(DimEmployee[Division] <> BLANK(), 0, 1)
			VAR _jobTitle = IF(DimEmployee[Job Title] <> BLANK(), 0, 1)
			VAR _employmentType = IF(DimEmployee[Employment Type] <> BLANK(), 0, 1)
			VAR _startDate = IF(DimEmployee[Start Date] <> BLANK(), 0, 1)
			VAR _probationDate = SWITCH(
			    TRUE(),
			    DimEmployee[Employment Type] = "Casual" && DimEmployee[Probation End Date] = BLANK(), 0, 
			    DimEmployee[Probation End Date] <> BLANK(), 0, 
			    1)
			VAR _exitDate = SWITCH(
			    TRUE(),
			    DimEmployee[Employee Status] = "terminated" && DimEmployee[Termination Date] <> BLANK(), 0,
			    DimEmployee[Employee Status] = "active" && (DimEmployee[Termination Date] = BLANK() || DimEmployee[Termination Date] > TODAY()) , 0,
			    DimEmployee[Employee Status] = "expired" && DimEmployee[Termination Date] = BLANK(), 0,
			    DimEmployee[Employee Status] = "pending" && DimEmployee[Termination Date] = BLANK(), 0,
			    1)
			VAR _total = _division + _jobTitle + _employmentType + _startDate + _exitDate 
			RETURN  _total
			```
		formatString: 0
		lineageTag: 5359b0aa-9a2f-46f4-8d34-1103800eca77
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition DimEmployee = m
		mode: import
		queryGroup: EDP
		source =
				let
				    Source = Sql.Database(ServerName, DatabaseName),
				    Dim_employee = fnCleanColumnNames(Source{[Schema="Dim",Item="employee"]}[Data]),
				    #"Filtered Rows" = Table.SelectRows(Dim_employee, each [Division] <> "Admin" and [Division] <> "External"),
				    #"Added Division Order" = Table.AddColumn(#"Filtered Rows", "Division Order", each if [Division] = "Disability" then 0 else if [Division] = "CYF" then 1 else if [Division] = "V&A" then 2 else if [Division] = "GSL" then 3 else if [Division] = "Corporate Services" then 4 else if [Division] = "ASC" then 5 else if [Division] = "NHN" then 6 else if [Division] = "Finance" then 7 else if [Division] = "IT" then 8 else if [Division] = "NA" then 9 else if [Division] = "Kanda Foundation" then 10 else if [Division] = "APM" then 11 else if [Division] = "Quality" then 12 else if [Division] = "Office of the CEO" then 13 else if [Division] = "Transformation" then 14 else if [Division] = "Admin" then 15 else if [Division] = "External" then 16 else 17),
				    #"Added Age Band" = Table.AddColumn(
				    #"Added Division Order",
				    "Age Band",
				    each
				        let
				            DOB     = Date.From(DateTimeZone.FromText([Date Of Birth])),
				            Today   = Date.From(DateTime.LocalNow()),
				            Age     = Date.Year(Today) - Date.Year(DOB)
				                      - (if (Date.Month(Today) < Date.Month(DOB))
				                            or (Date.Month(Today) = Date.Month(DOB)
				                                and Date.Day(Today) < Date.Day(DOB))
				                         then 1 else 0),
				            Band    = if DOB = null          then null
				                      else if Age < 21       then "Under 21"
				                      else if Age <= 34      then "21-34"
				                      else if Age <= 49      then "35-49"
				                      else                       "50+"
				        in
				            Band,
				    type text
				),
				    #"Added Age Band Order" = Table.AddColumn(
				    #"Added Age Band",
				    "Age Band Order",
				    each
				        let
				            DOB     = Date.From(DateTimeZone.FromText([Date Of Birth])),
				            Today   = Date.From(DateTime.LocalNow()),
				            Age     = Date.Year(Today) - Date.Year(DOB)
				                      - (if (Date.Month(Today) < Date.Month(DOB))
				                            or (Date.Month(Today) = Date.Month(DOB)
				                                and Date.Day(Today) < Date.Day(DOB))
				                         then 1 else 0),
				            Band    = if DOB = null          then 5
				                      else if Age < 21       then 1
				                      else if Age <= 34      then 2
				                      else if Age <= 49      then 3
				                      else                       4
				        in
				            Band,
				    type number
				),
				    #"Added Probation Status" = Table.AddColumn(
				    #"Added Age Band Order",
				    "Probation Status",
				    each
				        let
				            Today           = Date.From(DateTime.LocalNow()),
				            StartDate       = [Start Date],
				            TerminationDate = [Termination Date],
				            ProbationEnd    = Date.From([Probation End Date]),
				
				            Status =
				                if [Employment Type] = "Casual" then "Casual employee"
				                else if StartDate = null or ProbationEnd = null then "Probation not defined"
				                else if TerminationDate = null then
				                    if ProbationEnd <= Today then "Passed"
				                    else "In Probation"
				                else if ProbationEnd >= TerminationDate then "Failed"
				                else "Passed"
				        in
				            Status,
				    type text
				),
				    #"Added Role Group" = Table.AddColumn(#"Added Probation Status",
				    "Role Group",
				    each
				        if List.Contains({"Support Worker", "Clinical"}, [Role Category])                                    then "Client Facing"
				        else if List.Contains({"Case Manager", "Team Leader", "Service Manager", "Regional Manager"}, [Role Category]) then "Non-Client Facing"
				        else if List.Contains({"Corporate", "Executive", "General Manager"}, [Role Category])                then "Corporate"
				        else "Unclassified",
				    type text
				),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Role Group",{{"Probation End Date", type date}, {"Date Of Birth", type datetime}, {"Division Order", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

