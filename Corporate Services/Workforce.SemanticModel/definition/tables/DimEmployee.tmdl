/// Definition: A person with an active profile in Employment Hero, the organisation's HR and payroll system. A profile is active from the employee's start date until their termination date. In this report: employees in every division except Admin and External, one row per employee, from the HR employee table in L4_Analytical.
/// For analysis: Group workforce results here. Start Date is the active date join; other dates are inactive.
table DimEmployee
	lineageTag: 4665117d-f844-41f8-94c7-2eab6692a01e

	/// Definition: Data quality flag for the probation end date: 0 when it is set, or blank for a casual employee; 1 when it is missing.
	/// For analysis: Conditional formatting helper. Not for analysis.
	measure ProbationBlankValid = ```
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE(DimEmployee[Employment Type]) = "Casual" && SELECTEDVALUE(DimEmployee[Probation End Date]) = BLANK(), 0, 
			    SELECTEDVALUE(DimEmployee[Probation End Date]) <> BLANK(), 0, 
			1)
			```
		formatString: 0
		lineageTag: 28e6311d-9fca-4bf2-8336-07736bef3b84

	/// Definition: Data quality flag for the termination date: 0 when it matches the employment status (terminated with a date; active with no date or a future date; expired or pending with no date); 1 otherwise.
	/// For analysis: Conditional formatting helper. Not for analysis.
	measure ExitDateBlankValid =
			SWITCH(TRUE(),
			    SELECTEDVALUE(DimEmployee[Employee Status]) = "terminated" && SELECTEDVALUE(DimEmployee[Termination Date]) <> BLANK(), 0,
			    SELECTEDVALUE(DimEmployee[Employee Status]) = "active" && (SELECTEDVALUE(DimEmployee[Termination Date]) = BLANK() || SELECTEDVALUE(DimEmployee[Termination Date]) > TODAY()) , 0,
			    SELECTEDVALUE(DimEmployee[Employee Status]) = "pending", 0,
			    SELECTEDVALUE(DimEmployee[Employee Status]) = "expired", 0,
			    1)
		formatString: 0
		lineageTag: 6049bcff-524a-4788-87d2-2912e39ee644

