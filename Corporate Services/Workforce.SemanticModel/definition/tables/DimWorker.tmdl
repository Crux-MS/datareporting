				    Dim_vw_worker_milestones = fnCleanColumnNames(Source{[Schema="Dim",Item="vw_worker_milestones"]}[Data]),
				    #"Add Division Order" = Table.AddColumn(#"Dim_vw_worker_milestones", "Division Order", each if [Worker Division] = "Disability" then 0 else if [Worker Division] = "CYF" then 1 else if [Worker Division] = "V&A" then 2 else if [Worker Division] = "GSL" then 3 else if [Worker Division] = "Corporate Services" then 4 else if [Worker Division] = "ASC" then 5 else if [Worker Division] = "NHN" then 6 else if [Worker Division] = "Finance" then 7 else if [Worker Division] = "IT" then 8 else if [Worker Division] = "NA" then 9 else if [Worker Division] = "Kanda Foundation" then 10 else if [Worker Division] = "APM" then 11 else if [Worker Division] = "Quality" then 12 else if [Worker Division] = "Office of the CEO" then 13 else if [Worker Division] = "Transformation" then 14 else if [Worker Division] = "Admin" then 15 else if [Worker Division] = "External" then 16 else 17),
				    #"Added Conditional Column" = Table.AddColumn(#"Add Division Order", "Start Flag Order", each if [Start Flag] = "Never Start (Active)" then 0 else if [Start Flag] = "Never Start (Exited)" then 1 else if [Start Flag] = "Started" then 2 else if [Start Flag] = "Exited" then 3 else null),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Conditional Column",{{"Division Order", Int64.Type}, {"Start Flag Order", Int64.Type}})
