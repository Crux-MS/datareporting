	partition 'Dim Workers' = m
		mode: import
		queryGroup: Utilities
		source =
				let
				    Source = fnCleanColumnNames(Sql.Database(ServerName, DatabaseName, [Query="SELECT [Id_Worker]#(lf)      ,w.[Id_Employee_Payroll]#(lf)      ,e.[Employee_Name]    AS [Employee_Name]#(lf)      ,[Division]           AS [Employee_Division]#(lf)      ,e.[Employment_Type]  AS [Employee_Employment_Type]#(lf)      ,e.[Role_Category]        AS [Employee_Role_Category]#(lf)      ,e.[Manager_Name]#(lf)      ,e2.[Role_Category] AS [Manager_Role_Category]#(lf)  FROM [Dim].[worker] w#(lf)  LEFT JOIN [Dim].[employee] e ON w.[Id_Employee_Payroll] = e.[Id_Employee_Payroll]#(lf)  LEFT JOIN [Dim].[employee] e2 ON e.[Id_Manager] = e2.[Id_Employee]#(lf)  WHERE e.Employee_Status = 'active'"]))
				in
				    Source

