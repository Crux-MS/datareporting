table 'Fact Worker Roster'
	lineageTag: fc56e263-7a09-47ed-80fa-6f2f2c78d77c

	measure EmployeeCompletedShifts =
			VAR _today = TODAY ()
			VAR _windowStart =
			    SWITCH (
			        TRUE (),
			        SELECTEDVALUE ( WeeksMonths[WeeksMonths Fields] ) = "'Dim Date'[Start of Month]", EDATE ( DATE ( YEAR ( _today ), MONTH ( _today ), 1 ), -6 ),
			        SELECTEDVALUE ( WeeksMonths[WeeksMonths Fields] ) = "'Dim Date'[Start of Week]", _today - (12 * 7)
			    )
			RETURN
			    CALCULATE (
			        SUM('Fact Worker Roster'[Duration Hours]),          // <-- your daily metric
			        KEEPFILTERS (
			            'Dim Date'[Date] >= _windowStart && 'Dim Date'[Date] <= _today
			        ),
			        'Fact Worker Roster'[Has Timesheet] = 1
			    )
		lineageTag: c2cae87a-fddb-408b-8a77-2f973dde31d4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

