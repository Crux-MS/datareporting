	partition DimDate = m
		mode: import
		source =
				let
				    Source = Sql.Database("yntrrjdg3j4eblsx4xrnbtn7xu-3nzrwlnfp2be7fmcsksohwynmq.datawarehouse.fabric.microsoft.com", #"DatabaseName"),
				    Dim_date = Source{[Schema="Dim",Item="date"]}[Data],
				    Custom1 = fnCleanColumnNames(Dim_date),
				    #"Inserted Start of Month" = Table.AddColumn(Custom1, "Start of Month", each Date.StartOfMonth([Date]), type date),
				    #"Inserted Start of Week" = Table.AddColumn(#"Inserted Start of Month", "Start of Week", each Date.StartOfWeek([Date]), type date),
				    #"Added MMM YYYY" = Table.AddColumn(#"Inserted Start of Week", "MMM YYYY", each Text.Combine({Date.ToText([Date], "MMM"), " ", Date.ToText([Date], "yyyy")}), type text),
				    #"Added YYYYMM" = Table.AddColumn(#"Added MMM YYYY", "YYYYMM", each if Date.Month([Date]) <=9 then Text.From([Year]) & "0" & Text.From(Date.Month([Date])) else Text.From([Year]) & Text.From(Date.Month([Date]))),
				    #"Added Rolling Date Difference" = Table.AddColumn(#"Added YYYYMM", "RollingDateDifference", each Duration.Days([Date] - Date.From(DateTime.LocalNow()))),
				    #"Added Slicer MMM YYYY" = Table.AddColumn(#"Added Rolling Date Difference", "Slicer MMM YYYY", each let
				    currentMonthYear = List.First(
				        Table.SelectRows(#"Added Rolling Date Difference", each [RollingDateDifference] = 0)[MMM YYYY]
				    )
				in
				    if [MMM YYYY] = currentMonthYear then "Current Month" else [MMM YYYY]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Slicer MMM YYYY",{{"Slicer MMM YYYY", type text}, {"RollingDateDifference", Int64.Type}, {"YYYYMM", Int64.Type}})
				in
				    #"Changed Type"

