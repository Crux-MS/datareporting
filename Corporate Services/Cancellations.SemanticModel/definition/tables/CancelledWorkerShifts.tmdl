table CancelledWorkerShifts
	lineageTag: 9601e5ec-c8c3-4305-b3c8-e4c139a5178a

	measure CancelledWorkerShiftCount = ```
			VAR _workerName = SELECTEDVALUE(CancelledWorkerShifts[Worker Name])
			VAR _minDate = CALCULATE(MIN(DimDate[Date]), ALLSELECTED())
			VAR _maxDate = CALCULATE(MAX(DimDate[Date]), ALLSELECTED())
			VAR _logic = CALCULATE(
			    COUNT(CancelledWorkerShifts[Id Roster]), 
			    REMOVEFILTERS(),
			    CancelledWorkerShifts[Worker Name] = _workerName,
			    DimDate[Date] >= _minDate && DimDate[Date] <= _maxDate
			)
			RETURN _logic
			```
		formatString: 0
		lineageTag: d4e61516-14d0-4aac-b29b-b5605d0f39e4

	measure CancelledWorkerShiftThresholds =
			VAR _startDate = CALCULATE(MIN(DimDate[Date]), ALLSELECTED())
			VAR _endDate = CALCULATE(MAX(DimDate[Date]), ALLSELECTED())
			VAR _durationWeeks = DATEDIFF(_startDate, _endDate, WEEK)
			VAR _shiftCount = CancelledWorkerShifts[CancelledWorkerShiftCount]
			VAR _logic = SWITCH(TRUE(),
			    _durationWeeks = 2 && _shiftCount >= 3, 1,
			    _durationWeeks = 2 && _shiftCount < 3, 2,
			    _durationWeeks = 6 && _shiftCount >= 6, 3,
			    _durationWeeks = 6 && _shiftCount < 6, 4,
			    _durationWeeks > 6 && _shiftCount > 6, 5,
			    6
			)
			RETURN _logic
		formatString: 0
		lineageTag: e36f950a-cad7-4f8a-9b0c-122cd879d4b2

