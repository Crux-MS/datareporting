	partition CancelledWorkerShifts = m
		mode: import
		source =
				let
				    Source = Sql.Database("yntrrjdg3j4eblsx4xrnbtn7xu-3nzrwlnfp2be7fmcsksohwynmq.datawarehouse.fabric.microsoft.com", "L3_Conformed", [Query="SELECT [Id_Roster]#(lf)      ,[Id_Client]#(lf)      ,[Id_Location]#(lf)      ,w.Id_Employee#(lf)      ,w.Id_Area                        AS [Worker_Area]#(lf)      ,w.First_Name + ' ' + w.Last_Name AS Worker_Name#(lf)      ,sm.Employee_Name                 AS Service_Manager_Name#(lf)      ,e.Job_Title                      AS Employee_Job_Title#(lf)      ,e.Employment_Type#(lf)      ,CASE #(lf)        WHEN e.Employee_Status = 'active' THEN 'Active' #(lf)        WHEN e.Employee_Status = 'terminated' THEN 'Exited'#(lf)        ELSE 'Unknown'#(lf)      END AS Employee_Status#(lf)      ,w.Division                       AS Worker_Division    #(lf)      ,sc.[Description]                 AS Service_Description#(lf)      ,sc.Is_Cancellation#(lf)      ,[Date_Of_Service]#(lf)      ,[Start_Datetime]#(lf)      ,[End_Datetime]#(lf)      ,[Duration_Minutes]#(lf)  FROM [Rostering].[worker_rosters] wr#(lf)  LEFT JOIN Employee.workers w ON wr.Id_Worker = w.Id_Worker#(lf)  LEFT JOIN Employee.employees e ON w.Id_Employee = e.Id_Employee_Payroll#(lf)  LEFT JOIN Employee.employees sm ON e.Id_Manager = sm.Id_Employee#(lf)  LEFT JOIN [Client].service_categories sc ON wr.Id_Service = sc.Id_Service#(lf)  Where sc.Is_Cancellation = 1 AND wr.[Id_Timesheet] <> -1"]),
				    #"Clean Column Names" = fnCleanColumnNames(Source),
				    #"Inserted Division" = Table.AddColumn(#"Clean Column Names", "Duration Hours", each [Duration Minutes] / 60, type number),
				    #"Inserted Text Before Delimiter" = Table.AddColumn(#"Inserted Division", "State", each Text.BeforeDelimiter([Worker Area], "-"), type text),
				    #"Replaced Value" = Table.ReplaceValue(#"Inserted Text Before Delimiter","Q","QLD",Replacer.ReplaceText,{"State"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Replaced Value",{{"Date Of Service", type date}})
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception

